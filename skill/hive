#!/usr/bin/env bash
# hive — command a swarm of Claude Code agents in herdr.
# One drone = one herdr workspace = one pane with an interactive Claude Code (opus).
# Communication: brief in a file -> drone works -> report in a file. Zero TUI scraping.
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HIVE_DIR="${HIVE_DIR:-$HOME/.herdr-hive}"
DRONES_DIR="$HIVE_DIR/drones"
MAIL_DIR="$HIVE_DIR/mail"
MODEL="${HIVE_MODEL:-opus}"
mkdir -p "$DRONES_DIR" "$MAIL_DIR"
# Labels for a letter's kind — shared by the watcher line and the inbox listing.
export MAIL_KIND_LABELS='{"decision":"DECISION","done":"finished"}'

die() { echo "hive: $*" >&2; exit 1; }
command -v herdr >/dev/null || die "herdr not found in PATH"

# --- helpers --------------------------------------------------------------

# Extracts a field from a herdr JSON response. Usage: jqp '<python path>' <<<"$json"
jqp() { python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
r=d.get('result',d)
$1" 2>/dev/null; }

# Is the herdr server up AND willing to talk to this client? A real API round trip, because the
# cheap signals lie: herdr 0.9 'status server' exits 0 even when no server runs, and a server left
# over from before a client update is "running" yet rejects every call with protocol_mismatch.
# In both cases every pane lookup fails, so every drone would read as dead.
herdr_reachable() { herdr workspace list >/dev/null 2>&1; }

# Returns text sitting in the drone's input field (last '>' line in the frame), empty when clean.
# CRITICAL: the prompt is shared with the human. If the user typed something and did not send it,
# our 'enter' would send THEIR text, and our message would glue itself onto their sentence.
prompt_pending() {
  local pane="$1"
  herdr pane read "$pane" --source visible --lines 60 --format ansi 2>/dev/null | python3 -c "
import re,sys
# Claude Code suggests ready-made prompts as ghost text rendered DIMMED (SGR 2).
# That is NOT user text — Enter does not send it. Real typed input is bright.
# Take the last prompt line and count only characters outside dim fragments.
SGR = re.compile(r'\x1b\[([0-9;]*)m')
def bright_text(raw):
    out, dim, pos = [], False, 0
    for m in SGR.finditer(raw):
        if not dim: out.append(raw[pos:m.start()])
        for c in (m.group(1) or '0').split(';'):
            if c == '2': dim = True
            elif c in ('0', '22', ''): dim = False
        pos = m.end()
    if not dim: out.append(raw[pos:])
    return ''.join(out)
last = ''
for raw in sys.stdin.read().splitlines():
    if SGR.sub('', raw).strip().startswith('❯'):
        last = bright_text(raw).strip().lstrip('❯').strip()
print(last)
" 2>/dev/null
}

# --- coordinator mail watcher -----------------------------------------------
# The coordinator's prompt belongs to the human too, so coord mail is never typed into it. The
# coordinator keeps 'hive watch' armed as a Claude Code Monitor instead: every stdout line becomes
# a notification in its session, and the prompt stays free for the human.
# Globals, not locals: cmd_watch's EXIT trap reads them after the function has returned.
WATCH_BEAT="$HIVE_DIR/.watch-coord"        # heartbeat, touched every ~10 s by the live watcher
WATCH_OWNER="$HIVE_DIR/.watch-coord.pid"   # PID of the watcher armed last
# The copy-paste arm instruction. The Monitor tool refuses a call without a description.
WATCH_ARM='Monitor(command: "hive watch", description: "swarm mail", timeout_ms: 1800000)'

# Is a watcher listening? 'hive watch' touches its heartbeat every ~10 s, so 30 s of silence means
# its monitor expired or its session is gone. A fresh heartbeat proves that SOME watcher lives, not
# that the session asking has one.
coord_watched() {
  [ -f "$WATCH_BEAT" ] || return 1
  [ $(( $(date +%s) - $(stat -c %Y "$WATCH_BEAT" 2>/dev/null || echo 0) )) -lt 30 ]
}

# Computes the event line for a coord letter: sender, kind, subject — never the body. Control
# characters are flattened, because every stdout line of the watcher is a separate notification.
# The caller prints the line, so that a failed write can stop the watcher.
watch_line() {
  python3 - "$1" <<'PY' 2>/dev/null
import json,os,re,sys
try:
    e=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)          # archived by 'hive inbox' between the listing and this read
flat=lambda s: re.sub(r'[\x00-\x1f\x7f]+',' ',str(s or '')).strip()
kind=json.loads(os.environ.get('MAIL_KIND_LABELS','{}')).get(e.get('kind'),'message')
line=f"HIVE-MAIL {flat(e.get('from')) or '?'} [{kind}] {flat(e.get('subject'))}"
print(line if len(line)<=120 else line[:117]+'...')
PY
}

# --- swarm mail -----------------------------------------------------------
# Mailbox = a directory of message files. No daemon, no MTA: writes are atomic (mv).
# A drone is woken by wake_recipient; the coordinator hears its mail through the watcher above.

coord_pane() { cat "$HIVE_DIR/coord.pane" 2>/dev/null; }

# Non-empty when the coordinator lives on another machine (hive coord --remote <ssh-host>).
coord_remote() { cat "$HIVE_DIR/coord.remote" 2>/dev/null; }

mailbox_put() {  # mailbox_put <from> <to> <kind> <subject> <body>
  local from="$1" to="$2" kind="$3" subject="$4" body="$5"
  local box="$MAIL_DIR/$to"; mkdir -p "$box"
  local tmp; tmp=$(mktemp "$box/.tmp.XXXXXX") || return 1
  python3 -c "
import json,sys,time
tmp,frm,to,kind,subject,body = sys.argv[1:7]
json.dump({'ts':time.strftime('%Y-%m-%d %H:%M:%S'),'from':frm,'to':to,
           'kind':kind,'subject':subject,'body':body},
          open(tmp,'w'), ensure_ascii=False, indent=1)
" "$tmp" "$from" "$to" "$kind" "$subject" "$body" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$box/$(date +%s%N)-$from.json"
}

# Desktop escalation for coord mail nobody is watching (no live 'hive watch' heartbeat). The
# coordinator's prompt is never typed into, so without a watcher the letters wait in silence —
# the one failure the swarm cannot heal on its own, so the human gets a ping.
# Rate-limited by a marker so a burst of drone hooks does not fire one ping per letter.
coord_stranded_notice() {
  local mark="$HIVE_DIR/.stranded-notice" age n
  if [ -f "$mark" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$mark" 2>/dev/null || echo 0) ))
    [ "$age" -lt 900 ] && return 0
  fi
  : > "$mark"
  n=$(find "$MAIL_DIR/coord" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l)
  herdr notification show \
    "Swarm mail waiting, no coordinator is watching ($n letters). In the coordinator session: hive coord, then arm Monitor(hive watch)" \
    --sound request >/dev/null 2>&1
}

# Wakes a DRONE by injecting a message into its prompt. Safeguards:
#  - only when the drone's prompt is EMPTY (never overwrite a human's text)
#  - flock: two senders never write into one prompt at the same time
#  - marker: one wake-up per batch, until the drone runs 'hive inbox'
#  - marker TTL: a delivered wake-up is not a handled one (Esc, a restarted session,
#    mail read without 'hive inbox') — a marker older than HIVE_WAKE_TTL (default 900 s)
#    counts as a LOST wake-up and is retried; without the TTL one lost prompt would
#    silence the mailbox forever
# The coordinator is never woken this way — see the mail watcher above.
wake_recipient() {
  local who="$1" pane=""
  if [ "$who" = coord ]; then
    # A remote coordinator has no watcher on this machine — the letter waits in the mailbox
    # (cmd_send forwards over ssh; this path only runs when that forward failed).
    [ -n "$(coord_remote)" ] && return 0
    # A live watcher prints the letter within a second; without one, the human gets a ping.
    coord_watched || coord_stranded_notice
    return 0
  fi
  pane=$(pane_of "$who" 2>/dev/null)
  [ -n "$pane" ] || return 0
  # An adopted agent has no HIVE_DRONE until revive: woken now, its 'hive inbox' would read and
  # archive the coordinator's mailbox. Its letters wait until revive gives it the swarm env.
  [ "$(meta_get "$who" adopted)" = True ] && return 0

  exec 9>"$HIVE_DIR/.wake-lock"
  flock -w 15 9 || return 0
  local mark="$HIVE_DIR/.wake-$who" age
  if [ -f "$mark" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$mark" 2>/dev/null || echo 0) ))
    [ "$age" -lt "${HIVE_WAKE_TTL:-900}" ] && return 0   # already woken, do not spam
    rm -f "$mark"                                        # stale — retry the wake-up
  fi
  case "$(pane_status "$pane")" in
    dead|blocked) return 0 ;;
  esac
  [ -n "$(prompt_pending "$pane")" ] && return 0   # human is typing — leave it, mail can wait

  # herdr 0.8: agent prompt appends Enter itself and honors bracketed-paste; for a recipient
  # mid-turn Claude Code queues the message, and one stuck at a dialog is rejected (agent_blocked).
  herdr agent prompt "$pane" "HIVE-MAIL: new mail. Run: hive inbox" >/dev/null 2>&1 || return 0
  : > "$mark"
}

drone_dir()  { echo "$DRONES_DIR/$1"; }
drone_meta() { echo "$DRONES_DIR/$1/meta.json"; }

# Single field from a mail json file. jqf <file> <key>
jqf() { python3 -c "import json,sys; print((json.load(open(sys.argv[1])).get(sys.argv[2]) or ''))" "$1" "$2" 2>/dev/null; }

meta_get() {  # meta_get <drone> <key>
  [ -f "$(drone_meta "$1")" ] || return 1
  python3 -c "
import json,sys
print(json.load(open('$(drone_meta "$1")')).get('$2',''))" 2>/dev/null
}

pane_of() { meta_get "$1" pane_id; }

# Current pane status straight from herdr (idle|working|blocked|unknown|dead)
pane_status() {
  local pane="$1" out
  out=$(herdr pane get "$pane" 2>/dev/null) || { echo dead; return; }
  echo "$out" | jqp "p=r.get('pane',r); print(p.get('agent_status') or 'unknown')" || echo dead
}

# Is the pane stuck on a Claude Code dialog (trust / permission / resume / choice)?
# 'resume' is the one a drone hits on its own: when its session runs out of context and is
# resumed, Claude Code asks whether to continue from a summary or replay the full session,
# and the drone sits there until somebody answers.
pane_dialog() {
  local pane="$1" txt
  txt=$(herdr pane read "$pane" --source visible --lines 30 2>/dev/null) || return 1
  case "$txt" in
    *"trust this folder"*)        echo trust ;;
    *"Yes, I accept"*)            echo consent ;;
    *"Resume from summary"*)      echo resume ;;
    *"Do you want to proceed"*)   echo permission ;;
    *"requires approval"*)        echo permission ;;
    *) return 1 ;;
  esac
}

# Status of a drone by NAME, not by pane. A directory left over from a drone whose meta.json
# is gone has no pane at all — that is the archetypal ghost, and it counts as dead.
drone_state() {
  local pane; pane=$(pane_of "$1" 2>/dev/null) || { echo dead; return; }
  [ -n "$pane" ] || { echo dead; return; }
  pane_status "$pane"
}

# --- archive --------------------------------------------------------------
# Reports are evidence. Nothing removes a drone directory without a copy landing here first,
# unless the caller explicitly asks for a hard delete (--purge).

# hive_archive <label> <name>... — packs the drones' directories + mailboxes into one tarball.
# Prints the archive path on success; returns non-zero when there was nothing to pack or tar failed.
hive_archive() {
  local label="$1"; shift
  local adir="$HIVE_DIR/archive"; mkdir -p "$adir" || return 1
  local base="$adir/$label-$(date +%Y%m%d-%H%M%S)"
  # Two archives in the same second must not overwrite each other — the second one would
  # silently destroy the evidence the first one had just rescued.
  local out="$base.tar.gz" i=2
  while [ -e "$out" ]; do out="$base-$i.tar.gz"; i=$((i+1)); done
  local -a paths=(); local n
  for n in "$@"; do
    [ -d "$DRONES_DIR/$n" ] && paths+=("drones/$n")
    [ -d "$MAIL_DIR/$n" ]   && paths+=("mail/$n")
  done
  [ ${#paths[@]} -gt 0 ] || return 1
  # Paths relative to $HIVE_DIR, so the tarball unpacks straight back over the hive directory.
  tar -czf "$out" -C "$HIVE_DIR" "${paths[@]}" 2>/dev/null || { rm -f "$out"; return 1; }
  printf '%s\n' "$out"
}

# drone_remove <name> — the directory, the mailbox and the wake-up marker. No archiving here:
# the caller decides that, and it must have happened BEFORE this runs.
drone_remove() {
  rm -rf "$(drone_dir "$1")" "$MAIL_DIR/$1"
  rm -f "$HIVE_DIR/.wake-$1"
}

# Claude Code accounts. A drone runs on the default account (~/.claude with ~/.claude.json) or on a
# named one: its own CLAUDE_CONFIG_DIR at ~/.claude-<name>, holding its own login and its own
# .claude.json (trust, onboarding, MCP servers). HIVE_ACCOUNT sets the account 'spawn' uses when no
# --account is given; "" or "default" is the default account.
# account_dir <name> — prints the account's config dir, nothing for the default account. Refuses an
# account that is not logged in or never finished onboarding: the drone would hang on the login or
# onboarding screen, which the startup bootstrap does not answer.
account_dir() {
  local acc="$1" d
  case "$acc" in ""|default) return 0 ;; esac
  [[ "$acc" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || die "account '$acc' rejected: [a-z0-9][a-z0-9_-]{0,31}"
  d="$HOME/.claude-$acc"
  [ -d "$d" ] || die "account '$acc': no config dir $d"
  [ -f "$d/.credentials.json" ] \
    || die "account '$acc' is not logged in — run: CLAUDE_CONFIG_DIR=$d claude   (then /login)"
  python3 -c "import json,sys; sys.exit(0 if json.load(open(sys.argv[1])).get('hasCompletedOnboarding') is True else 1)" \
      "$d/.claude.json" 2>/dev/null \
    || die "account '$acc' never finished onboarding — run once interactively: CLAUDE_CONFIG_DIR=$d claude"
  echo "$d"
}

# account_label <name> — the account as shown to the human
account_label() { case "${1:-}" in ""|default) echo default ;; *) echo "$1" ;; esac; }

# ensure_trusted <cwd> [config_dir] — pre-seed folder trust so a fresh --cwd never raises Claude Code's
# "Do you trust this folder?" dialog. That dialog appears despite --dangerously-skip-permissions
# (it is a separate gate), and its default button is "No, exit", which QUITS Claude Code — so
# answering it blind by keystroke kills the drone. Setting hasTrustDialogAccepted in the config
# makes the dialog never appear. Best-effort: every failure path is non-fatal (an unparseable or
# concurrently-written config is left untouched), and the keystroke bootstrap in cmd_spawn stays
# as a fallback. The config is the drone's account, never the caller's CLAUDE_CONFIG_DIR: the drone
# shell is spawned by the herdr server and does not inherit the caller's environment (a coordinator
# running on a second account exports CLAUDE_CONFIG_DIR into every command it runs).
ensure_trusted() {
  local cwd="$1" cfg
  if [ -n "${2:-}" ]; then cfg="$2/.claude.json"; else cfg="$HOME/.claude.json"; fi
  python3 - "$cfg" "$cwd" <<'PY' 2>/dev/null || true
import json,os,sys,tempfile
cfg,cwd=sys.argv[1],sys.argv[2]
try:
    with open(cfg) as f: d=json.load(f)
except FileNotFoundError:
    d={}
except Exception:
    sys.exit(0)          # never clobber a config we could not parse
if not isinstance(d,dict): sys.exit(0)
proj=d.setdefault("projects",{})
if not isinstance(proj,dict): sys.exit(0)
ent=proj.setdefault(cwd,{})
if not isinstance(ent,dict): sys.exit(0)
if ent.get("hasTrustDialogAccepted") is True: sys.exit(0)   # already trusted, no write
ent["hasTrustDialogAccepted"]=True
dd=os.path.dirname(cfg) or "."
fd,tmp=tempfile.mkstemp(dir=dd)
try:
    with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2,ensure_ascii=False)
    os.replace(tmp,cfg)                 # atomic swap; a racing writer loses at most this flag
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
PY
}

# --- account selection ------------------------------------------------------
# A fleet burns an account's limits in hours, so a new drone lands on the account that has room:
# accounts.conf lists the accounts in the owner's order, usage-cache.json holds the last /usage
# measurement of each, and 'hive accounts' shows both. Without accounts.conf nothing here runs and
# a drone stays on the default account, as before.
ACCOUNTS_CONF="$HIVE_DIR/accounts.conf"
USAGE_CACHE="$HIVE_DIR/usage-cache.json"

# usage_precheck <account> <cwd> — what must hold before a measurement: tmux, the directory, the
# account. Says why on stderr; returns 3 when the account cannot run Claude Code at all, 1 otherwise.
usage_precheck() {
  command -v tmux >/dev/null || { echo "hive: usage: tmux not found" >&2; return 1; }
  (cd "$2") 2>/dev/null || { echo "hive: usage: no such directory: $2" >&2; return 1; }
  (account_dir "$1") >/dev/null || return 3     # in a subshell: account_dir dies, and only it may
}

# usage_capture <account> <cwd> <timeout> — prints the raw /usage panel of one account.
# Starts a fresh `claude` in a tmux session (in a TRUSTED directory — the trust dialog is not answered
# on purpose), types /usage, captures the panel and kills the session. Returns 3 when the account
# cannot run Claude Code at all (not logged in, no config dir), 1 when the measurement failed.
# MUST run in a subshell — $(...) or ( ... ) & — because the EXIT trap that kills the throwaway
# session belongs to that subshell. The trap covers a hive that exits or is killed by TERM/INT/HUP;
# sessions orphaned by SIGKILL are collected by usage_sweep at the next measurement.
usage_capture() {
  local account="$1" cwd="$2" timeout="$3"
  usage_precheck "$account" "$cwd" || return $?
  cwd=$(cd "$cwd" && pwd)   # absolute, because the trust key in .claude.json is the absolute path
  local acc_dir; acc_dir=$(account_dir "$account")
  # The measured account is set explicitly both ways: the caller's CLAUDE_CONFIG_DIR (a coordinator
  # on a second account exports it) must not decide which account's limits get printed. A named
  # account gets its cwd pre-trusted like a drone's — a fresh account trusts no folder at all.
  local acc_env="-u CLAUDE_CONFIG_DIR"
  if [ -n "$acc_dir" ]; then acc_env="CLAUDE_CONFIG_DIR=$(printf '%q' "$acc_dir")"; ensure_trusted "$cwd" "$acc_dir"; fi
  # The account is part of the name: accounts are measured in parallel from one hive process.
  # tmux matches a bare target by PREFIX — "-t …-ab" would hit the session of account "abc" — so
  # every target is exact: "=name" for a session, "=name:" for its pane.
  local ses="hive-usage-$$-$(account_label "$account")" out
  tmux kill-session -t "=$ses" 2>/dev/null
  # The name is expanded now: the trap fires after this function returned and its locals are gone.
  trap "tmux kill-session -t $(printf '%q' "=$ses") 2>/dev/null" EXIT
  # 120 rows: the limit sections sit under the plugin list, and a longer list must not push them
  # off the captured screen.
  tmux new-session -d -s "$ses" -x 200 -y 120 -c "$cwd" \
    "env -u CLAUDECODE -u HIVE_DRONE -u HERDR_HIVE_ROLE $acc_env claude" || return 1
  local i=0
  while [ $i -lt "$timeout" ]; do
    out=$(tmux capture-pane -t "=$ses:" -p 2>/dev/null)
    case "$out" in
      *"Yes, I trust this folder"*)
        echo "hive: usage: $cwd is not a trusted folder for Claude Code — run from a trusted project or pass --cwd" >&2
        return 1 ;;
      *"Select login method"*)
        # A credentials file with a dead token: Claude Code opens on the login selector, whose
        # cursor is the same ❯ as the prompt. Typing /usage into it would start a login.
        echo "hive: account '$(account_label "$account")' is logged out (Claude Code opens on the login screen) — run: ${acc_dir:+CLAUDE_CONFIG_DIR=$acc_dir }claude   (then /login)" >&2
        return 3 ;;
      *"❯"*) break ;;
    esac
    sleep 1; i=$((i+1))
  done
  [ $i -lt "$timeout" ] || { echo "hive: usage: claude did not start in ${timeout}s" >&2; return 1; }
  sleep 2
  tmux send-keys -t "=$ses:" '/usage'; sleep 1; tmux send-keys -t "=$ses:" Enter
  # The panel is complete once the weekly section carries its percentage. A panel without a weekly
  # section never gets there, so three polls of a panel that shows any percentage settle it too.
  local seen=0
  i=0
  while [ $i -lt "$timeout" ]; do
    out=$(tmux capture-pane -t "=$ses:" -p 2>/dev/null)
    case "$out" in
      *"Current week"*"% used"*) break ;;
      *"% used"*) seen=$((seen+1)); [ "$seen" -ge 3 ] && break ;;
    esac
    sleep 1; i=$((i+1))
  done
  [ $i -lt "$timeout" ] || { echo "hive: usage: no /usage panel in ${timeout}s" >&2; return 1; }
  printf '%s\n' "$out"
}

# accounts_py <subcommand> [args] — the accounts engine: config, cache, /usage parser, table, ranking.
#   check                 validates accounts.conf (exit 2 when missing, 1 when broken)
#   due <all|stale>       names of the enabled accounts to measure now
#   store <dir> <name>... stores measurements: <dir>/<name>.panel|.err|.rc, written by accounts_refresh
#   parse <file> [epoch]  parses one captured panel, prints JSON (the parser on its own, for the tests)
#   table                 the 'hive accounts' table
#   rank                  the accounts a spawn may take, best first: <name>\t<reason> per line
#   room <name>           exit 0 when that account still has room for the drone running on it; prints why
accounts_py() {
  python3 - "$ACCOUNTS_CONF" "$USAGE_CACHE" "$@" <<'PY'
import json, os, re, sys, tempfile, time
from datetime import datetime, timedelta
try:
    from zoneinfo import ZoneInfo
except ImportError:
    ZoneInfo = None

conf_path, cache_path, cmd, args = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
HOME = os.path.expanduser('~')
now = int(time.time())

def fail(msg, code=1):
    print('hive: accounts: ' + msg, file=sys.stderr)
    sys.exit(code)

# --- accounts.conf ---
NAME = re.compile(r'^(default|[a-z0-9][a-z0-9_-]{0,31})$')
FORMAT = '''one account per line, lower prio = preferred:

  max_age = 10                                    # minutes a measurement stays good for a spawn
  account alt      prio=1  week_threshold=80      # "alt" = ~/.claude-alt; 80% of the WEEKLY limit = over threshold
  account default  prio=2  week_threshold=60  hard       # hard: over the threshold = never used
  account spare    prio=3  disabled                      # disabled: never used, never measured

The threshold is on the weekly limit (default 90). The session limit blocks an account only at 100%;
session_threshold=<percent> makes it count as "over threshold" earlier.'''

def load_conf():
    try:
        raw = open(conf_path, encoding='utf-8').read()
    except FileNotFoundError:
        fail(f'no config at {conf_path} — without it a drone stays on the default account.\n'
             f'Create it, {FORMAT}', 2)
    except (OSError, UnicodeDecodeError) as e:      # unreadable, a directory, not text
        fail(f'{conf_path} cannot be read: {e}')
    conf, errs = {'max_age': 10, 'accounts': []}, []
    for no, line in enumerate(raw.splitlines(), 1):
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        m = re.match(r'^max_age\s*=\s*(\d+)$', line)
        if m:
            conf['max_age'] = int(m.group(1))
            if conf['max_age'] < 1:
                errs.append(f'line {no}: max_age is in minutes, 1 or more')
            continue
        tok = line.split()
        if tok[0] != 'account' or len(tok) < 2:
            errs.append(f'line {no}: expected "account <name> ..." or "max_age = <minutes>"')
            continue
        # The threshold belongs to the weekly limit. A session is a 5-hour window that comes back by
        # itself, so by default it only counts when it is full (100 = no session threshold).
        acc = {'name': tok[1], 'prio': None, 'week_threshold': 90, 'session_threshold': 100,
               'hard': False, 'disabled': False, 'order': len(conf['accounts'])}
        if not NAME.match(acc['name']):
            errs.append(f'line {no}: account name {acc["name"]!r} rejected: default or [a-z0-9][a-z0-9_-]{{0,31}}')
        if any(a['name'] == acc['name'] for a in conf['accounts']):
            errs.append(f'line {no}: account {acc["name"]!r} is listed twice')
        for t in tok[2:]:
            key, _, val = t.partition('=')
            val = val.rstrip('%')
            if t in ('hard', 'disabled'):
                acc[t] = True
            elif key == 'prio' and val.isdigit():
                acc['prio'] = int(val)
            elif key in ('week_threshold', 'session_threshold') and val.isdigit() and 1 <= int(val) <= 100:
                acc[key] = int(val)
            else:
                errs.append(f'line {no}: {t!r} not understood — prio=<n>, week_threshold=<1-100>, '
                            f'session_threshold=<1-100>, hard, disabled')
        conf['accounts'].append(acc)
    if not conf['accounts'] and not errs:
        errs.append('no "account" line')
    if errs:
        fail(f'{conf_path} is broken:\n  ' + '\n  '.join(errs) + f'\nFormat — {FORMAT}')
    for a in conf['accounts']:
        if a['prio'] is None:
            a['prio'] = a['order'] + 1      # no prio = the position in the file
    conf['accounts'].sort(key=lambda a: (a['prio'], a['order']))
    return conf

def limits(acc):
    """The thresholds of an account as the human reads them: 'week 80%', plus the session one when set."""
    return f'week {acc["week_threshold"]}%' + (
        f', session {acc["session_threshold"]}%' if acc['session_threshold'] < 100 else '')

def email(name):
    path = os.path.join(HOME, '.claude.json' if name == 'default' else f'.claude-{name}/.claude.json')
    try:
        with open(path, encoding='utf-8') as f:
            return (json.load(f).get('oauthAccount') or {}).get('emailAddress') or '-'
    except Exception:
        return '-'

# --- usage-cache.json ---
def clean(entry):
    """One cache entry with every field of the type the rest of the engine relies on. Hive writes
    them that way; a hand-edited file must end as 'no data', not as a traceback that refuses a spawn."""
    if not isinstance(entry, dict):
        return {}
    num = lambda v: v if isinstance(v, (int, float)) and not isinstance(v, bool) else None
    text = lambda v: v if isinstance(v, str) else None
    out = {}
    if None not in (num(entry.get('measured_at')), num(entry.get('session_pct')), num(entry.get('week_pct'))):
        out['measured_at'] = entry['measured_at']
        for key in ('session', 'week'):
            out[key + '_pct'] = entry[key + '_pct']
            out[key + '_reset'] = num(entry.get(key + '_reset'))
            out[key + '_reset_text'] = text(entry.get(key + '_reset_text'))
    if text(entry.get('error')):
        out['error'], out['error_at'] = entry['error'], num(entry.get('error_at')) or 0
        if entry.get('unusable') is True:
            out['unusable'] = True
    return out

def load_cache():
    try:
        with open(cache_path, encoding='utf-8') as f:
            d = json.load(f)
        if isinstance(d, dict) and isinstance(d.get('accounts'), dict):
            return {'accounts': {name: clean(entry) for name, entry in d['accounts'].items()}}
    except Exception:
        pass
    return {'accounts': {}}

def save_cache(cache):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cache_path) or '.', prefix='.usage-cache.')
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(cache, f, indent=1, ensure_ascii=False)
    os.replace(tmp, cache_path)

# --- the /usage panel ---
# A limit section is three lines: its label, a bar ending in "N% used", and "Resets <when>".
# Sections are found by label: the panel also prints lines like "93% of your usage was at >150k
# context", which are not limits.
SECTIONS = (('session', ('Current session',)),
            ('week', ('Current week (all models)', 'Current week')))
PCT = re.compile(r'(?<![\d.,])(\d{1,3})(?:[.,]\d+)?%\s*used')    # "35.5% used" is 35, never 5
RESET = re.compile(r'^Resets\s+(?:(?P<mon>[A-Za-z]{3})[a-z]*\.?\s+(?P<day>\d{1,2})(?:\s*,|\s+at)?\s+)?'
                   r'(?P<h>\d{1,2})(?::(?P<m>\d{2}))?\s*(?P<ap>[ap]m)?\s*(?:\((?P<tz>[^)]+)\))?\s*$', re.I)
MONTHS = {m: i for i, m in enumerate('jan feb mar apr may jun jul aug sep oct nov dec'.split(), 1)}

def reset_epoch(line, at):
    """'Resets 4:10pm (Europe/Berlin)' / 'Resets Oct 15, 9am (Europe/Berlin)' -> epoch, None when not understood."""
    m = RESET.match(line)
    if not m:
        return None
    tz = None
    if m['tz'] and ZoneInfo:
        try:
            tz = ZoneInfo(m['tz'].strip())
        except Exception:
            tz = None
    base = datetime.fromtimestamp(at, tz)       # no zone on the panel = this machine's local time
    hour, minute, ap = int(m['h']), int(m['m'] or 0), (m['ap'] or '').lower()
    if ap:
        if not 1 <= hour <= 12:
            return None
        hour = hour % 12 + (12 if ap == 'pm' else 0)
    try:
        if m['mon']:
            month = MONTHS.get(m['mon'].lower())
            if not month:
                return None
            when = base.replace(month=month, day=int(m['day']), hour=hour, minute=minute, second=0, microsecond=0)
            if when < base - timedelta(days=1):     # the panel prints no year: "Jan 2" seen in December
                when = when.replace(year=when.year + 1)
        else:
            when = base.replace(hour=hour, minute=minute, second=0, microsecond=0)
            if when <= base - timedelta(minutes=1): # a bare time already behind us is tomorrow's
                when += timedelta(days=1)
    except ValueError:
        return None
    return int(when.timestamp())

def parse_panel(text, at):
    """-> (fields, None) or (None, why). Both sections are required: a panel that lost one is a
    changed format, and guessing would report an exhausted account as free."""
    lines = [l.strip() for l in text.splitlines()]
    out, missing = {}, []
    for key, labels in SECTIONS:
        idx = next((i for lab in labels for i, l in enumerate(lines) if l == lab), None)
        if idx is None:
            missing.append(f'no "{labels[0]}" section')
            continue
        body = [l for l in lines[idx + 1:] if l][:2]
        m = PCT.search(body[0]) if body else None
        if not m:
            missing.append(f'no percentage under "{lines[idx]}"')
            continue
        out[key + '_pct'] = int(m.group(1))
        out[key + '_reset'] = out[key + '_reset_text'] = None
        if len(body) > 1 and body[1].lower().startswith('resets'):
            out[key + '_reset'] = reset_epoch(body[1], at)
            out[key + '_reset_text'] = body[1][len('Resets'):].strip()
    if missing:
        return None, 'the /usage panel was not understood: ' + ', '.join(missing)
    out['measured_at'] = at
    return out, None

# --- status ---
def view(entry):
    """The entry as it stands NOW: a window whose reset time has passed since the measurement is over."""
    v = {'measured_at': entry.get('measured_at')}
    for key in ('session', 'week'):
        pct, reset, text = entry.get(key + '_pct'), entry.get(key + '_reset'), entry.get(key + '_reset_text')
        if pct is not None and reset and reset <= now:
            pct, reset, text = 0, None, None
        v[key], v[key + '_reset'], v[key + '_reset_text'] = pct, reset, text
    return v

def status(acc, entry):
    """-> (kind, text); kind: disabled | unusable | nodata | full | over_hard | over | ok."""
    if acc['disabled']:
        return 'disabled', 'disabled'
    if entry.get('unusable'):
        return 'unusable', 'UNAVAILABLE: ' + entry.get('error', 'account cannot run Claude Code')
    v = view(entry)
    if v['measured_at'] is None:
        return 'nodata', 'no data' + (f' — measurement failed: {entry["error"]}' if entry.get('error') else '')
    failed = f' — last measurement FAILED: {entry["error"]}' if entry.get('error') else ''
    for key in ('week', 'session'):
        if (v[key] or 0) >= 100:
            return 'full', f'UNAVAILABLE: {key} 100%' + failed
    over = [key for key in ('session', 'week') if (v[key] or 0) >= acc[key + '_threshold']]
    if over and acc['hard']:
        return 'over_hard', 'over threshold: ' + ', '.join(over) + ' (hard)' + failed
    if over:
        return 'over', 'over threshold: ' + ', '.join(over) + failed
    return 'ok', 'available' + failed

def blocked_until(acc, entry):
    """When a full or over-a-hard-threshold account gets its room back: the latest reset among the
    windows that block it. None when a reset time is unknown."""
    v = view(entry)
    resets = [v[key + '_reset'] for key in ('session', 'week')
              if (v[key] or 0) >= (acc[key + '_threshold'] if acc['hard'] else 100)]
    return max(resets) if resets and all(resets) else None

def is_fresh(conf, entry):
    return entry.get('measured_at') is not None and now - entry['measured_at'] <= conf['max_age'] * 60

def rank(conf, cache):
    """The accounts a spawn may take, best first, as (account, reason). One ranking serves the pick
    and the table's SELECTED mark, so the two cannot disagree on the same stored numbers.
    Measured within max_age: under the threshold by priority, then over it and not hard, by priority
    (last resort). Behind them the accounts without a fresh measurement (blind): by priority those
    last seen under their threshold or never measured, then those last seen over it. Usage only
    grows inside a window, so an old 'over' is still over and an old 'full' is still full, while an
    old 'available' is a guess. Never: disabled, unusable, full, over a hard threshold.
    A spawn re-measures whatever is older than max_age before it asks."""
    below, last_resort, blind, blind_over, passed = [], [], [], [], []
    for acc in conf['accounts']:
        entry = cache['accounts'].get(acc['name'], {})
        kind, text = status(acc, entry)
        v = view(entry)
        numbers = f'session {v["session"]}%, week {v["week"]}%'
        head = f'prio {acc["prio"]}'
        ahead = f'; passed over: {", ".join(passed)}' if passed else ''
        state = text.split(' — ')[0]
        if kind == 'nodata' or (kind in ('ok', 'over') and not is_fresh(conf, entry)):
            why = text if kind == 'nodata' else f'last measured {age(now - v["measured_at"])} ago ({numbers})'
            (blind_over if kind == 'over' else blind).append(
                (acc, f'BLIND — no fresh usage data: {why}; {head}{ahead}'))
            state = f'{state}, stale' if kind == 'over' else 'no fresh usage data'
        elif kind == 'ok':
            below.append((acc, f'{head}, {numbers}, under its threshold ({limits(acc)}){ahead}'))
            continue        # taken in its turn, so never "passed over"
        elif kind == 'over':
            last_resort.append((acc, f'LAST RESORT — no account is under its threshold; {head}, {numbers}, '
                                     f'its threshold ({limits(acc)}) is not hard{ahead}'))
        passed.append(f'{acc["name"]} ({state})')
    return below + last_resort + blind + blind_over

def room(conf, cache, name):
    """Does the account a drone runs on still have room for it? -> (yes, why). A drone leaves its
    account only on evidence: an account outside accounts.conf, or one without a measurement, keeps it."""
    acc = next((a for a in conf['accounts'] if a['name'] == name), None)
    if acc is None:
        return True, f'{name} is not in accounts.conf'
    entry = cache['accounts'].get(name, {})
    kind, text = status(acc, entry)
    if kind == 'nodata':
        return True, text
    if kind != 'ok':
        return False, text.split(' — ')[0]
    v = view(entry)
    measured = '' if is_fresh(conf, entry) else f', measured {age(now - v["measured_at"])} ago'
    return True, f'session {v["session"]}%, week {v["week"]}%, under its threshold ({limits(acc)}){measured}'

# --- output ---
def age(sec):
    sec = max(0, int(sec))
    if sec < 60:
        return '<1 min'
    if sec < 3600:
        return f'{sec // 60} min'
    return f'{sec // 3600}h{sec % 3600 // 60:02d}m'

def until(sec):
    sec = max(0, int(sec))
    d, h, m = sec // 86400, sec % 86400 // 3600, sec % 3600 // 60
    return f'{d}d{h}h' if d else f'{h}h{m:02d}m' if h else f'{m}m'

def table(conf, cache):
    color = sys.stdout.isatty() and not os.environ.get('NO_COLOR')
    paint = lambda code, s, width=0: (f'\x1b[{code}m{s}\x1b[0m' if color and code else s) + ' ' * max(0, width - len(s))
    KIND_COLOR = {'ok': '32', 'over': '33', 'nodata': '33', 'over_hard': '31', 'full': '31',
                  'unusable': '31', 'disabled': '2'}
    pinned = os.environ.get('HIVE_ACCOUNT') or ''
    ranked = rank(conf, cache)
    selected = pinned if pinned else (ranked[0][0]['name'] if ranked else None)
    rows, measured = [], []
    for acc in conf['accounts']:
        entry = cache['accounts'].get(acc['name'], {})
        kind, text = status(acc, entry)
        v = view(entry)
        if not acc['disabled'] and v['measured_at'] is not None:
            measured.append(v['measured_at'])
        def pct(key):
            p = v[key] if v['measured_at'] is not None and not acc['disabled'] else None
            if p is None:
                return ('', '-')
            return ('31' if p >= 100 else '33' if p >= acc[key + '_threshold'] else '32', f'{p}%')
        def reset(key, relative):
            if acc['disabled'] or v['measured_at'] is None:
                return '-'
            if v[key + '_reset']:
                s = time.strftime('%b %d %H:%M', time.localtime(v[key + '_reset']))
                return s + (f' (in {until(v[key + "_reset"] - now)})' if relative else '')
            return v[key + '_reset_text'] or '-'
        if acc['name'] == selected:
            text += ' <- SELECTED' + (' (HIVE_ACCOUNT)' if pinned else '')
            kind_color = '32'
        else:
            kind_color = KIND_COLOR[kind]
        rows.append([(kind_color, acc['name']), ('', 'claude'), ('', str(acc['prio'])),
                     ('', limits(acc) + (' hard' if acc['hard'] else '')), ('', email(acc['name'])),
                     pct('session'), ('', reset('session', True)), pct('week'), ('', reset('week', False)),
                     (kind_color, text)])
    if not measured:
        print('usage: never measured — run: hive accounts --refresh')
    else:
        oldest = now - min(measured)
        stale = oldest > conf['max_age'] * 60
        print(f'usage from {age(oldest)} ago' + (
            f' — STALE (max_age {conf["max_age"]} min): a spawn re-measures before it picks; '
            f'refresh now: hive accounts --refresh' if stale else ''))
    head = ['ACCOUNT', 'ENGINE', 'PRIO', 'THRESHOLD', 'EMAIL', 'SESSION', 'SESSION RESET', 'WEEK', 'WEEK RESET', 'STATUS']
    widths = [max(len(head[i]), *(len(r[i][1]) for r in rows)) for i in range(len(head))]
    print('  '.join(h.ljust(w) for h, w in zip(head, widths)).rstrip())
    for r in rows:
        print('  '.join(paint(code, s, w) for (code, s), w in zip(r, widths)).rstrip())
    if pinned:
        print(f'HIVE_ACCOUNT={pinned} is set: spawn uses it and the automatic selection is off'
              + ('' if any(a['name'] == pinned for a in conf['accounts']) else f' ({pinned} is not in accounts.conf)'))
    elif not ranked:
        print('no account is selectable: a spawn without --account is refused until a limit resets')

if cmd == 'parse':
    at = int(args[1]) if len(args) > 1 else now
    fields, why = parse_panel(open(args[0], encoding='utf-8', errors='replace').read(), at)
    if why:
        fail(why)
    print(json.dumps(fields, indent=1))
    sys.exit(0)

conf = load_conf()
cache = load_cache()

if cmd == 'check':
    pass
elif cmd == 'due':
    for acc in conf['accounts']:
        entry = cache['accounts'].get(acc['name'], {})
        tried = max(entry.get('measured_at') or 0, entry.get('error_at') or 0)
        if not acc['disabled'] and (args[0] == 'all' or now - tried > conf['max_age'] * 60):
            print(acc['name'])
elif cmd == 'store':
    tmp = args[0]
    read = lambda name, ext: open(os.path.join(tmp, f'{name}.{ext}'), encoding='utf-8', errors='replace').read()
    for name in args[1:]:
        old = cache['accounts'].get(name, {})
        try:
            rc = int(read(name, 'rc').strip() or 1)
        except Exception:
            rc = 1
        fields = why = None
        if rc == 0:
            fields, why = parse_panel(read(name, 'panel'), now)
            if why:
                # Evidence for whoever has to teach the parser the new panel.
                keep = os.path.join(os.path.dirname(cache_path), f'usage-panel-{name}.txt')
                try:
                    with open(keep, 'w', encoding='utf-8') as f:
                        f.write(read(name, 'panel'))
                    why += f' (raw panel kept in {keep})'
                except OSError:
                    pass
        else:
            err = [l.strip() for l in read(name, 'err').splitlines() if l.strip()]
            why = re.sub(r'^hive: (usage: )?', '', err[-1]) if err else f'measurement failed (exit {rc})'
        if fields:
            cache['accounts'][name] = fields
        else:
            # A failed attempt keeps the last good numbers: usage only grows inside a window, so they
            # still say something. An account that cannot run Claude Code at all has nothing to keep.
            entry = {} if rc == 3 else {k: v for k, v in old.items() if k not in ('error', 'error_at', 'unusable')}
            entry.update(error=why, error_at=now)
            if rc == 3:
                entry['unusable'] = True
            cache['accounts'][name] = entry
            print(f'accounts: {name}: {why}', file=sys.stderr)
    save_cache(cache)
elif cmd == 'table':
    table(conf, cache)
elif cmd == 'room':
    yes, why = room(conf, cache, args[0])
    print(why)
    sys.exit(0 if yes else 1)
elif cmd == 'rank':
    ranked = rank(conf, cache)
    if not ranked:
        # Nothing to take: say for every account what blocks it and when that ends, and which is first.
        clock = lambda t: f'{time.strftime("%b %d %H:%M", time.localtime(t))} (in {until(t - now)})'
        lines, first = [], None
        for acc in conf['accounts']:
            entry = cache['accounts'].get(acc['name'], {})
            kind, text = status(acc, entry)
            back = blocked_until(acc, entry) if kind in ('full', 'over_hard') else None
            if back and (first is None or back < first[0]):
                first = (back, acc['name'])
            lines.append(f'  {acc["name"]}: {text}' + (f' — room again {clock(back)}' if back else ''))
        fail('no account is selectable:\n' + '\n'.join(lines)
             + (f'\nFirst to get room: {first[1]}, {clock(first[0])}.' if first else '')
             + '\nWait for that reset, or force an account with --account NAME.', 3)
    for acc, reason in ranked:
        print(f'{acc["name"]}\t{reason}')
else:
    fail(f'unknown engine command {cmd!r}')
PY
}

# usage_sweep — kills the measurement sessions of hive processes that no longer exist. A hive killed
# by SIGKILL runs no trap, and its throwaway Claude Code sessions would sit in tmux for good. The pid
# in the session name says whose it is; the session of a live hive is a measurement in progress.
usage_sweep() {
  local ses pid
  for ses in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^hive-usage-[0-9]+-[a-z0-9_-]+$'); do
    pid=${ses#hive-usage-}; pid=${pid%%-*}
    kill -0 "$pid" 2>/dev/null || tmux kill-session -t "=$ses" 2>/dev/null
  done
}

# accounts_refresh <all|stale> — measures the enabled accounts (all of them, or the ones whose
# measurement is older than max_age) in parallel, one throwaway session each, and stores the result.
# Serialised by a lock: two spawns that both find the cache stale measure once. Each step of a
# measurement (Claude Code starting, the panel loading) is bounded by HIVE_USAGE_TIMEOUT seconds.
accounts_refresh() {
  local mode="$1" timeout="${HIVE_USAGE_TIMEOUT:-45}" names n tmp rc=0
  exec 7>"$HIVE_DIR/.usage-lock"
  flock -w 150 7 || { echo "hive: accounts: another measurement holds the lock (150 s) — nothing measured" >&2; return 1; }
  # Decided under the lock: a measurement another process has just stored makes this one a no-op.
  names=$(accounts_py due "$mode") || { flock -u 7; return 1; }
  if [ -n "$names" ]; then
    tmp=$(mktemp -d) || { flock -u 7; return 1; }
    trap "rm -rf $(printf '%q' "$tmp")" EXIT     # a hive killed mid-measurement leaves no litter
    usage_sweep
    echo "accounts: measuring $(echo $names) — /usage in a throwaway session each, up to ${timeout}s per step" >&2
    local -a pids=()
    for n in $names; do
      # The session runs in $HOME, where no project hooks or MCP servers load. usage_capture
      # pre-trusts it for a named account; the default account gets it here, the way a spawn
      # without --cwd does — otherwise its measurement would stop on the trust dialog.
      [ "$n" = default ] && ensure_trusted "$(cd "$HOME" && pwd)"
      # fd 7 is closed for the child — a tmux server born here would otherwise hold the lock for good.
      ( usage_capture "$n" "$HOME" "$timeout" >"$tmp/$n.panel" 2>"$tmp/$n.err"; echo $? >"$tmp/$n.rc" ) 7>&- &
      pids+=($!)
    done
    wait "${pids[@]}"
    accounts_py store "$tmp" $names || rc=1
    rm -rf "$tmp"; trap - EXIT
  fi
  flock -u 7
  return "$rc"
}

# account_pick [session-id [own-account]] — the account a drone lands on when nobody named one.
# Prints "<name>\t<reason>"; progress and refusals go to stderr. Stale measurements are refreshed
# first: landing a drone on an account that filled up an hour ago costs more than the seconds /usage
# takes, and the measurement is bounded by its timeout.
# A revive passes the drone's session id and the account it runs on. The drone then keeps its
# account for as long as that account has room, and moves only off one that is over its threshold,
# full, unusable or disabled — to an account that sees the session's transcript.
account_pick() {
  local sid="${1:-}" own="${2:-}" ranked name reason dir note="" left=""
  accounts_py check >&2 || return 1      # a broken accounts.conf is reported once, before anything is measured
  accounts_refresh stale >&2 || echo "hive: accounts: picking on the measurements already stored" >&2
  if [ -n "$own" ]; then
    if reason=$(accounts_py room "$own"); then printf '%s\t%s\n' "$own" "$reason"; return 0; fi
    left="$own has no room ($reason); "
  fi
  ranked=$(accounts_py rank) || return 1
  while IFS=$'\t' read -r name reason; do
    # account_dir has the last word on whether an account can run a drone; the cache may be behind.
    if ! dir=$(account_dir "$name" 2>/dev/null); then
      note+="; $name cannot run Claude Code"; continue
    fi
    if [ -n "$sid" ] && ! compgen -G "${dir:-$HOME/.claude}/projects/*/$sid.jsonl" >/dev/null; then
      note+="; $name does not see session $sid"; continue
    fi
    # Its own account can still top the ranking, as the last resort: then the drone stays after all.
    if [ -n "$left" ] && [ "$name" != "$own" ]; then reason="$left$name: $reason"; fi
    printf '%s\t%s%s\n' "$name" "$reason" "$note"
    return 0
  done <<<"$ranked"
  echo "hive: accounts: no selectable account can take this drone${note}" >&2
  return 1
}

# auto_account — true when the account is hive's to choose: accounts.conf exists and HIVE_ACCOUNT
# does not pin one. (--account is checked by the caller: it always wins.)
auto_account() { [ -z "${HIVE_ACCOUNT:-}" ] && [ -f "$ACCOUNTS_CONF" ]; }

# --- commands -------------------------------------------------------------

cmd_spawn() {  # spawn <name> [--cwd PATH] [--account NAME] [--resume]
  local name="${1:?usage: hive spawn <name> [--cwd PATH] [--account NAME]}"; shift
  # herdr 0.8: the drone name doubles as the herdr agent name — [a-z][a-z0-9_-]{0,31} applies,
  # unique among live agents.
  [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "name '$name' rejected: herdr requires [a-z][a-z0-9_-]{0,31}"
  local cwd="$HOME" resume=0 account="${HIVE_ACCOUNT:-}" account_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --account) account="${2?--account needs a name}"; account_given=1; shift 2 ;;
      --resume) resume=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [ -d "$cwd" ] || die "cwd does not exist: $cwd"
  # A resumed session stays on the account it ran on unless moved explicitly — HIVE_ACCOUNT is the
  # default for NEW drones and must not quietly carry an existing one elsewhere.
  if [ "$resume" = 1 ] && [ "$account_given" = 0 ] && [ -f "$(drone_meta "$name")" ]; then
    account=$(meta_get "$name" account)
  elif [ "$account_given" = 0 ] && auto_account; then
    # Nobody named an account for this new drone: it lands on the one with room (see 'hive accounts').
    local picked; picked=$(account_pick) || die "spawn: no account for $name — nothing started"
    account="${picked%%$'\t'*}"
    echo "spawn: account $account — ${picked#*$'\t'}"
  fi
  local acc_dir; acc_dir=$(account_dir "$account") || exit 1
  [ "$account" = default ] && account=""
  ensure_trusted "$cwd" "$acc_dir"   # so a fresh cwd never stalls (or quits) on the trust dialog

  local dir; dir=$(drone_dir "$name"); mkdir -p "$dir"
  rm -f "$dir"/.sweep-* "$dir/.killed"   # a fresh life invalidates old sweep verdicts
  local sid
  if [ "$resume" = 1 ] && sid=$(meta_get "$name" session_id) && [ -n "$sid" ]; then
    : # resuming an existing session
  else
    sid=$(python3 -c "import uuid;print(uuid.uuid4())")
    resume=0
  fi

  # Coordinator pane = the one hive was called from. Saved because the coordinator hooks (Stop
  # backstop, SessionStart board) find the coordinator session through it.
  # (herdr 0.8.2: --current resolves the CALLING pane, not the pane focused in another client)
  local coord; coord=$(herdr pane current --current 2>/dev/null | jqp "print(r['pane']['pane_id'])")
  # Spawning from a local pane makes THIS pane the coordinator — a stale remote marker
  # would silently divert the fleet's mail to another machine. Over ssh there is no
  # calling pane, so a remote coordinator's registration survives untouched.
  # The rm also clears a wake-up marker left by pre-watcher versions and resets the
  # unwatched-mail alert's rate limit for the new coordinator.
  [ -n "$coord" ] && { echo "$coord" > "$HIVE_DIR/coord.pane"
                       rm -f "$HIVE_DIR/coord.remote" "$HIVE_DIR/.wake-coord" "$HIVE_DIR/.stranded-notice"; }

  # 1 workspace per drone, label = drone name. Swarm environment variables enter here —
  # herdr 0.8 injects --env into the root pane shell, and agent start has no --env at all.
  local -a envs=(--env "HIVE_DRONE=$name" --env "HIVE_DIR=$HIVE_DIR" --env "HERDR_HIVE_ROLE=drone")
  [ -n "$coord" ] && envs+=(--env "HIVE_COORD_PANE=$coord")
  # The default account gets no CLAUDE_CONFIG_DIR at all: an empty value is not "the default" to
  # Claude Code, it is a config dir named "" (logged out, measured on 2.1.283).
  [ -n "$acc_dir" ] && envs+=(--env "CLAUDE_CONFIG_DIR=$acc_dir")
  local ws_json ws pane
  ws_json=$(herdr workspace create --label "$name" --cwd "$cwd" --no-focus "${envs[@]}" 2>/dev/null) \
    || die "failed to create workspace"
  ws=$(jqp "print(r['workspace']['workspace_id'])" <<<"$ws_json")
  pane=$(jqp "print(r['root_pane']['pane_id'])" <<<"$ws_json")
  [ -n "$ws" ] && [ -n "$pane" ] || die "workspace create returned an incomplete response: $ws_json"

  # Swarm protocol lives in the system prompt, not in the brief — the drone knows it from
  # turn one and never loses it across tasks. The brief stays purely about the work.
  local sysprompt="You are drone '$name' in a swarm of agents run by a coordinator (another Claude Code).
The human does NOT read your terminal — only what you write to files and send counts.

Task report: write it to $dir/report.md (the brief gives the format). Without a report the task does not count.

Swarm mail (the 'hive' command, it is in PATH):
- send: hive send <recipient> '<subject>' --body '<text>'   (recipient: coord | drone name | all)
- read: hive inbox        (your mailbox; consumes messages)
- swarm: hive status      (who is alive and what they are working on)
When you see 'HIVE-MAIL' in your prompt — immediately run 'hive inbox' and handle its contents.
To talk to another drone use ONLY 'hive send'. Do not use 'hive say' or 'herdr' —
those are coordinator channels and you would corrupt the queue with them.

Report questions and blockers via 'hive send coord' — do not wait idly, nobody watches your panel."
  # herdr 0.8 cannot encode a multi-line argument for the target shell (invalid_agent_argument),
  # so the system prompt goes as a single line.
  sysprompt=$(printf '%s' "$sysprompt" | tr '\n' ' ' | tr -s ' ')

  local -a argv=(--dangerously-skip-permissions --model "$MODEL"
                 --settings "$SKILL_DIR/drone-settings.json"
                 --append-system-prompt "$sysprompt")
  if [ "$resume" = 1 ]; then argv+=(--resume "$sid"); else argv+=(--session-id "$sid"); fi

  # herdr 0.8: agent start targets an EXISTING pane (no splits, no orphaned shells)
  # and waits for agent readiness itself. On a startup dialog it returns agent_not_ready,
  # but the agent name stays live — the dialog is handled below.
  local start_out ready=0
  start_out=$(herdr agent start "$name" --kind claude --pane "$pane" --timeout 60000 \
                -- "${argv[@]}" 2>&1) && ready=1
  if [ "$ready" != 1 ]; then
    case "$start_out" in
      *agent_not_ready*) : ;;   # startup dialog — handled in the bootstrap below
      *) herdr workspace close "$ws" >/dev/null 2>&1
         die "failed to start the agent: $start_out" ;;
    esac
  fi

  # The account is recorded because 'revive' must resume on it: --resume looks the session up in
  # the account's projects/ directory.
  python3 - "$dir" "$name" "$ws" "$pane" "$sid" "$cwd" "$account" <<'PY'
import json,sys
d,name,ws,pane,sid,cwd,account = sys.argv[1:8]
json.dump({"name":name,"workspace_id":ws,"pane_id":pane,"session_id":sid,"cwd":cwd,"account":account},
          open(f"{d}/meta.json","w"), indent=1)
PY

  # Startup dialog bootstrap: the trust dialog appears despite --dangerously-skip-permissions
  # (for a new cwd), the bypass consent on first skip-permissions use on a machine
  # (option 2 = "Yes, I accept"), and the resume dialog when a long session is revived.
  # herdr reports all of them as 'blocked'.
  local i compacted=0
  for i in $(seq 1 12); do
    # A ready agent can still sit on the resume dialog if herdr classifies it as idle.
    [ "$ready" = 1 ] && [ "$(pane_dialog "$pane" 2>/dev/null)" != resume ] && break
    case "$(pane_dialog "$pane" 2>/dev/null)" in
      trust)
        # The dialog's default button is "No, exit" (quits Claude Code), so a bare enter would
        # kill the drone. Move down to "Yes, I trust this folder" first. This is only reached
        # when ensure_trusted() could not pre-seed the config; normally the dialog never shows.
        herdr agent send-keys "$name" down >/dev/null 2>&1
        sleep 0.3
        herdr agent send-keys "$name" enter >/dev/null 2>&1
        sleep 2 ;;
      consent)
        herdr pane send-text "$pane" 2 >/dev/null 2>&1
        sleep 1
        herdr agent send-keys "$name" enter >/dev/null 2>&1
        sleep 2 ;;
      resume)
        # A long session revived with --resume asks whether to resume from a summary or replay
        # the whole session. The summary is preselected and far cheaper, so Enter takes it —
        # but compaction drops detail, hence the loud warning below.
        herdr agent send-keys "$name" enter >/dev/null 2>&1
        compacted=1
        sleep 3 ;;
    esac
    herdr agent wait "$name" --until idle --until done --timeout 5000 >/dev/null 2>&1 && ready=1
  done
  sleep 2   # let SessionStart hooks finish their thing and release the prompt
  [ "$ready" = 1 ] || echo "warning: $name did not confirm readiness — check: hive peek $name" >&2
  [ "$compacted" = 1 ] && cat >&2 <<EOF
warning: $name had a long session and resumed FROM A SUMMARY (compaction can take ~2 min).
Compaction drops detail. Before tasking it: wait until its status is no longer 'working', then
restate what binds in one 'hive say' — state on disk, scope, boundaries. Do not assume it remembers.
EOF

  echo "spawn: $name  ws=$ws pane=$pane model=$MODEL account=$(account_label "$account") cwd=$cwd"
  echo "sid=$sid"
}

cmd_task() {  # task <name> <brief-file>  |  task <name> - (brief from stdin)
  local name="${1:?usage: hive task <name> <file|->}"; local src="${2:?missing brief}"
  local dir; dir=$(drone_dir "$name")
  [ -f "$(drone_meta "$name")" ] || die "unknown drone: $name"
  local pane; pane=$(pane_of "$name")

  if [ "$src" = "-" ]; then cat > "$dir/brief.md"; else cp "$src" "$dir/brief.md"; fi

  # reporting protocol appended to every brief
  cat >> "$dir/brief.md" <<EOF

---
## Reporting protocol (mandatory)
When the task is finished, WRITE a report to \`$dir/report.md\`:

    STATUS: DONE | BLOCKED | FAILED
    ## Result
    <concise: what you did, what you found out>
    ## Files
    <changed/created paths, or "none">
    ## Issues
    <what went wrong, what you need, or "none">

The report is the only channel to the coordinator — nobody reads your terminal.
Without a written report the task counts as not done.
If you get stuck or need something: write a report with STATUS: BLOCKED and describe what you need.
EOF

  # The previous report is archived, not deleted: it is often the input to the next turn (the
  # drone's own plan), and deleting it cut the drone off from its own conclusions.
  if [ -f "$dir/report.md" ]; then
    local prev; prev="$dir/report-$(date +%Y%m%d-%H%M%S).md"
    mv "$dir/report.md" "$prev" && echo "task: previous report of $name archived as $prev"
  fi
  rm -f "$dir"/.sweep-* "$dir/.killed"   # new task resets sweep verdicts

  local msg="Read $dir/brief.md and carry out the task it describes."
  # 'done' = the previous turn finished. Remember the pre-send state so a stale 'done'
  # cannot masquerade as delivery of the new task.
  local pre; pre=$(pane_status "$pane")
  [ "$pre" = dead ] && die "drone $name is dead"
  if [ "$pre" = working ]; then
    # Drone mid-turn: Claude Code queues the message, so deliver once and do not retry
    # (a retry would push the task into the queue a SECOND time).
    herdr agent prompt "$name" "$msg" >/dev/null 2>&1 || die "failed to send the task to $name"
    echo "task: $name is working — task queued, will run after the current turn"
    return 0
  fi

  local pending; pending=$(prompt_pending "$pane")
  [ -n "$pending" ] && die "drone $name has unsent text in its prompt: \"$pending\"
Not sending — Enter would send THAT, not my task. Sort the prompt out (hive clear $name) and retry."

  # herdr 0.8: agent prompt appends Enter atomically, and rejects a drone stuck at a dialog
  # (agent_blocked) without sending anything. herdr 0.9 reports success only once the text and
  # Enter are written — which still does not prove the agent started a turn. Delivery is therefore
  # CONFIRMED via status: a freshly started drone can lose its first input (SessionStart hooks
  # clear the prompt).
  local attempt i st out
  for attempt in 1 2 3; do
    out=$(herdr agent prompt "$name" "$msg" 2>&1) || {
      case "$out" in
        *agent_blocked*) die "drone $name is stuck at a dialog — check: hive peek $name" ;;
        *) die "failed to send the task to $name: $out" ;;
      esac
    }
    for i in 1 2 3 4 5 6; do
      sleep 2
      st=$(pane_status "$pane")
      [ "$st" = working ] && { echo "task: $name <- $dir/brief.md (attempt $attempt)"; return 0; }
      # A fast drone finishes the whole job between polls: report.md (moved aside before
      # sending) is hard proof of delivery; 'done' only counts when fresh.
      [ -f "$dir/report.md" ] && { echo "task: $name <- $dir/brief.md (attempt $attempt, fast finish)"; return 0; }
      [ "$st" = done ] && [ "$pre" != done ] && { echo "task: $name <- $dir/brief.md (attempt $attempt)"; return 0; }
      [ "$st" = dead ] && die "drone $name is dead"
    done
  done
  echo "task: $name — SENT but the drone did not start (status: $(pane_status "$pane")). Check: hive peek $name" >&2
  return 1
}

cmd_clear() {  # clear <name> — clears the drone's input field (ctrl+u)
  local name="${1:?usage: hive clear <name>}"
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  local pending; pending=$(prompt_pending "$pane")
  [ -z "$pending" ] && { echo "clear: $name — prompt already clean"; return 0; }
  echo "clear: $name — removing from the prompt: \"$pending\""
  herdr pane send-keys "$pane" ctrl+u >/dev/null 2>&1
  sleep 1
  local still; still=$(prompt_pending "$pane")
  [ -n "$still" ] && die "failed to clear the prompt (left over: \"$still\")"
  echo "clear: $name — clean"
}

cmd_say() {  # say <name> <text>  |  say <name> - (text from stdin, like task)
  local name="${1:?usage: hive say <name> <text|->}"; shift
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  local pending; pending=$(prompt_pending "$pane")
  [ -n "$pending" ] && die "drone $name has unsent text in its prompt: \"$pending\"
Not sending — Enter would send THAT. Sort the prompt out (hive clear $name) and retry."
  local text
  if [ "${1:-}" = "-" ] && [ $# -eq 1 ]; then
    text=$(cat)
    [ -n "$text" ] || die "say: stdin was empty — nothing sent"
  else
    text="$*"
  fi
  local out
  out=$(herdr agent prompt "$name" "$text" 2>&1) || case "$out" in
    *agent_blocked*) die "drone $name is stuck at a dialog — check: hive peek $name" ;;
    *) die "failed to send to $name: $out" ;;
  esac
  echo "say: $name <- ${text:0:120}"
}

cmd_watch() {  # watch — the coordinator's mail watcher; arm it as a Monitor, one line per new letter
  # A drone running this would take the watch over and leave the coordinator deaf.
  [ -n "${HIVE_DRONE:-}" ] && die "watch is the coordinator's mail watcher — drones read their mail with hive inbox"
  local box="$MAIL_DIR/coord"
  mkdir -p "$box"
  # Last armed wins: a second arm, or a new coordinator session taking over, retires this watcher.
  echo "$$" > "$WATCH_OWNER"
  touch "$WATCH_BEAT"
  # The heartbeat dies with its owner, and only with its owner: after a takeover it belongs to the
  # new watcher. bash runs the EXIT trap on fatal signals too, so a watcher killed by SIGPIPE
  # (reader gone) cleans up as well; a Monitor stop (TaskStop, expiry) is a plain exit 0.
  trap '[ "$(cat "$WATCH_OWNER" 2>/dev/null)" = "$$" ] && rm -f "$WATCH_BEAT"' EXIT
  trap 'exit 0' TERM INT HUP
  local -A seen=()
  local f line n=0 last_beat=$SECONDS
  for f in "$box"/*.json; do
    [ -e "$f" ] || continue
    seen[$f]=1; n=$((n+1))
  done
  # Every line is written from here and every write is checked: a watcher nobody reads any more
  # must stop, not keep a fresh heartbeat while its lines go nowhere.
  if [ "$n" -gt 0 ]; then printf '%s\n' "HIVE-MAIL backlog: $n unread — run hive inbox" || exit 0; fi
  while :; do
    sleep 1
    # Orphaned: the process that started us (the Monitor's session) is gone. $PPID is fixed at
    # start, so this holds even after the orphan was reparented.
    kill -0 "$PPID" 2>/dev/null || exit 0
    [ "$(cat "$WATCH_OWNER" 2>/dev/null)" = "$$" ] \
      || { echo "HIVE-WATCH: taken over by another watcher — stopping"; return 0; }
    local -A now=()
    for f in "$box"/*.json; do
      [ -e "$f" ] || continue
      now[$f]=1
      [ -n "${seen[$f]:-}" ] && continue
      line=$(watch_line "$f"); [ -z "$line" ] || printf '%s\n' "$line" || exit 0
    done
    # Forget letters 'hive inbox' archived, so the set never grows with the watcher's lifetime.
    # The guarded expansion keeps an empty mailbox legal under set -u on bash < 4.4.
    seen=()
    for f in ${now[@]+"${!now[@]}"}; do seen[$f]=1; done
    if [ $((SECONDS - last_beat)) -ge 10 ]; then touch "$WATCH_BEAT"; last_beat=$SECONDS; fi
  done
}

cmd_status() {  # status [name...] — never blocks
  # Passive reconciliation surface: status gets run often, so unread mail nobody acted on
  # (no watcher armed, a notification missed) resurfaces here, with the watcher state,
  # instead of rotting.
  local me="${HIVE_DRONE:-coord}" nmail
  nmail=$(find "$MAIL_DIR/$me" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l)
  [ "$nmail" -gt 0 ] && echo "mail ($me): $nmail unread letter(s) — run: hive inbox"
  if [ "$me" = coord ] && [ -z "$(coord_remote)" ]; then
    if coord_watched; then echo "watch: a watcher is live — if this session has no hive watch monitor, arm one: $WATCH_ARM"
    else echo "watch: NOT ARMED — arm $WATCH_ARM"; fi
  fi
  local names=()
  if [ $# -gt 0 ]; then names=("$@"); else
    for d in "$DRONES_DIR"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  fi
  [ ${#names[@]} -eq 0 ] && { echo "no drones"; return; }
  printf '%-16s %-8s %-10s %-9s %-9s %s\n' DRONE PANE ACCOUNT STATUS REPORT TASK
  local n pane st rep brief acc
  for n in "${names[@]}"; do
    pane=$(pane_of "$n" 2>/dev/null) || pane="-"
    st=$(pane_status "$pane")
    acc=$(account_label "$(meta_get "$n" account 2>/dev/null)")
    if [ -f "$(drone_dir "$n")/report.md" ]; then
      rep=$(grep -m1 -oE 'DONE|BLOCKED|FAILED' "$(drone_dir "$n")/report.md" 2>/dev/null || echo "present")
    else rep="-"; fi
    brief=$(head -1 "$(drone_dir "$n")/brief.md" 2>/dev/null | cut -c1-40)
    printf '%-16s %-8s %-10s %-9s %-9s %s\n' "$n" "$pane" "$acc" "$st" "$rep" "${brief:--}"
  done
}

cmd_wait() {  # wait [name...] [--timeout SEC] — ends on report/blocked, has a hard limit
  local timeout=300 names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      *) names+=("$1"); shift ;;
    esac
  done
  if [ ${#names[@]} -eq 0 ]; then
    for d in "$DRONES_DIR"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  fi
  local start; start=$(date +%s)
  local n pane st done_all elapsed
  while :; do
    done_all=1
    for n in "${names[@]}"; do
      [ -f "$(drone_dir "$n")/report.md" ] && continue      # report = finished
      pane=$(pane_of "$n" 2>/dev/null) || continue
      st=$(pane_status "$pane")
      case "$st" in
        blocked|dead) continue ;;                            # also finished, just badly
        done)
          # turn over; the report might not be flushed yet — give it a moment
          sleep 3
          [ -f "$(drone_dir "$n")/report.md" ] || echo "wait: $n finished a turn WITHOUT a report" >&2
          continue ;;
        *) done_all=0 ;;
      esac
    done
    elapsed=$(( $(date +%s) - start ))
    [ "$done_all" = 1 ] && break
    [ "$elapsed" -ge "$timeout" ] && { echo "wait: ${timeout}s limit reached"; break; }
    sleep 5
  done
  cmd_status "${names[@]}"
}

cmd_send() {  # send <to> <subject> [--body TEXT]  (without --body: body from stdin, optional)
  local to="${1:?usage: hive send <to|all> <subject> [--body TEXT]}"; shift
  local subject="${1:?missing subject}"; shift
  local body=""
  case "${1:-}" in
    --body) body="${2:-}" ;;
    *) [ -t 0 ] || body=$(cat) ;;
  esac
  local from="${HIVE_DRONE:-coord}"

  local -a targets=()
  if [ "$to" = all ]; then
    for d in "$DRONES_DIR"/*/; do
      [ -d "$d" ] || continue
      local n; n=$(basename "$d"); [ "$n" = "$from" ] || targets+=("$n")
    done
    [ "$from" = coord ] || targets+=(coord)
  else
    targets=("$to")
  fi
  [ ${#targets[@]} -eq 0 ] && { echo "send: no recipients"; return 0; }

  local t remote lhost
  remote=$(coord_remote); lhost=$(hostname -s)
  for t in "${targets[@]}"; do
    # Remote coordinator (hive coord --remote): coord mail travels over ssh and lands in the
    # coordinator machine's mailbox, where the watcher THERE reports it. The sender arrives as
    # '<name>@<this host>' so the coordinator knows which machine's fleet is talking.
    # When ssh fails, the letter stays in the local mailbox — undelivered but not lost;
    # the coordinator can still collect it with 'ssh <host> hive inbox'.
    if [ "$t" = coord ] && [ -n "$remote" ]; then
      if printf '%s' "$body" | ssh -o BatchMode=yes -o ConnectTimeout=5 "$remote" \
           "HIVE_DRONE=$(printf '%q' "$from@$lhost") KIND=$(printf '%q' "${KIND:-msg}") \
            \"\$HOME/.claude/skills/hivemind/hive\" send coord $(printf '%q' "$subject")" \
           >/dev/null 2>&1; then
        echo "send: $from -> coord@$remote: $subject"
        continue
      fi
    fi
    mailbox_put "$from" "$t" "${KIND:-msg}" "$subject" "$body" || continue
    wake_recipient "$t"
    echo "send: $from -> $t: $subject"
  done
}

cmd_inbox() {  # inbox [who] [--keep] — reads and consumes a mailbox (own by default)
  local who="" keep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep=1; shift ;;
      *) who="$1"; shift ;;
    esac
  done
  [ -n "$who" ] || who="${HIVE_DRONE:-coord}"
  local box="$MAIL_DIR/$who"
  mkdir -p "$box"

  # Release the wake-up BEFORE scanning: a letter landing while we read gets a fresh
  # wake-up instead of hiding behind the old marker until the next unrelated send.
  # Worst case is a spurious "inbox empty" next turn — losing a letter is worse.
  [ "$keep" = 0 ] && rm -f "$HIVE_DIR/.wake-$who"
  [ "$who" = coord ] && rm -f "$HIVE_DIR/.overdue-notice"   # mail is being read — stop nagging

  local -a msgs=()
  while IFS= read -r f; do msgs+=("$f"); done < <(find "$box" -maxdepth 1 -name '*.json' | sort)
  if [ ${#msgs[@]} -eq 0 ]; then
    echo "inbox ($who): empty"; rm -f "$HIVE_DIR/.wake-$who"; return 0
  fi

  python3 -c "
import json,os,sys
for p in sys.argv[1:]:
    try: e=json.load(open(p))
    except Exception: continue
    kind=json.loads(os.environ.get('MAIL_KIND_LABELS','{}')).get(e.get('kind'),'message')
    print(f\"── {e.get('ts','?')}  from: {e.get('from','?')}  [{kind}]\")
    print(f\"   {e.get('subject','')}\")
    b=(e.get('body') or '').strip()
    if b:
        for line in b.splitlines(): print(f\"   | {line}\")
" "${msgs[@]}"

  if [ "$keep" = 0 ]; then
    mkdir -p "$MAIL_DIR/.archive"
    mv "${msgs[@]}" "$MAIL_DIR/.archive/" 2>/dev/null
  fi
}

cmd_report() {  # report <name>
  local name="${1:?usage: hive report <name>}"
  local f; f="$(drone_dir "$name")/report.md"
  [ -f "$f" ] || { echo "no report from $name (status: $(pane_status "$(pane_of "$name")"))"; return 1; }
  cat "$f"
}

cmd_peek() {  # peek <name> [lines] — view of the drone's terminal
  local name="${1:?usage: hive peek <name> [lines]}"; local lines="${2:-40}"
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  herdr pane read "$pane" --source visible --lines "$lines" 2>/dev/null \
    || die "failed to read the pane"
}

cmd_mute() {  # mute <name> [--off] — silences the drone's automatic wake-ups
  local name="${1:?usage: hive mute <name> [--off]}"
  local dir; dir=$(drone_dir "$name")
  [ -d "$dir" ] || die "unknown drone: $name"
  if [ "${2:-}" = "--off" ]; then
    rm -f "$dir/.mute"; echo "mute: $name — wake-ups enabled again"
  else
    : > "$dir/.mute"
    echo "mute: $name — Stop/Notification hooks silenced (use for a conversational drone"
    echo "      the human talks to directly; 'hive send coord' from the drone still works)"
  fi
}

cmd_kill() {  # kill <name> [--purge]
  local name="${1:?usage: hive kill <name> [--purge]}"; local purge="${2:-}"
  local dir; dir=$(drone_dir "$name")
  [ -d "$dir" ] || die "unknown drone: $name"
  # The state is read BEFORE the workspace is closed — afterwards every drone looks dead,
  # and the difference between "killed just now" and "was already a corpse" would be lost.
  local state; state=$(drone_state "$name")
  # A directory without meta.json has no workspace to close; that is not a reason to refuse.
  local ws; ws=$(meta_get "$name" workspace_id) || ws=""
  [ -n "$ws" ] && herdr workspace close "$ws" >/dev/null 2>&1
  rm -f "$HIVE_DIR/.wake-$name"

  if [ "$purge" = "--purge" ]; then
    drone_remove "$name"
    echo "kill: $name (removed along with mailbox and history)"
    return
  fi
  if [ "$state" = dead ]; then
    # Killing a corpse used to leave the directory behind, so the drone kept haunting
    # 'hive status' forever. Consistent with prune: archive, then remove. No .killed marker
    # is needed here — the sweep cannot report a drone whose directory is gone.
    local arch
    if arch=$(hive_archive "kill-$name" "$name"); then
      drone_remove "$name"
      echo "kill: $name was already dead — archived to $arch and removed"
    else
      die "kill: $name is dead but archiving failed — nothing removed"
    fi
    return
  fi
  # Concluded on purpose — the sweep must not keep reporting this corpse as an anomaly.
  # The directory stays: killing a LIVING drone is usually done for its report.
  : > "$(drone_dir "$name")/.killed"
  echo "kill: $name (workspace $ws closed, report kept)"
}

cmd_prune() {  # prune [--purge] [--dry-run] [name...] — clears out dead drones
  local purge=0 dry=0 names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge)   purge=1; shift ;;
      --dry-run) dry=1; shift ;;
      -*) die "unknown argument: $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  if [ ${#names[@]} -eq 0 ]; then
    for d in "$DRONES_DIR"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  fi
  [ ${#names[@]} -eq 0 ] && { echo "prune: no drones"; return; }
  # An unreachable server makes every living drone read as dead — pruning then would sweep the swarm.
  herdr_reachable || die "prune: herdr server unreachable (down, or older than this client) — every drone would read as dead; nothing pruned"

  # Living drones are never touched — not even a blocked one, which is stuck rather than gone.
  local dead=() n st
  for n in "${names[@]}"; do
    [ -d "$(drone_dir "$n")" ] || { echo "prune: unknown drone: $n" >&2; continue; }
    st=$(drone_state "$n")
    if [ "$st" = dead ]; then dead+=("$n"); else echo "prune: keeping $n ($st)"; fi
  done
  [ ${#dead[@]} -eq 0 ] && { echo "prune: nothing to prune (0 dead drones)"; return; }

  if [ "$dry" = 1 ]; then
    printf 'prune: would remove %d dead drone(s)%s:\n' "${#dead[@]}" \
           "$([ "$purge" = 1 ] && echo ' without archiving' || echo ' after archiving')"
    printf '  %s\n' "${dead[@]}"
    return
  fi

  local arch=""
  if [ "$purge" = 0 ]; then
    arch=$(hive_archive prune "${dead[@]}") \
      || die "prune: archiving failed — nothing removed (use --purge to delete without an archive)"
  fi
  for n in "${dead[@]}"; do drone_remove "$n"; done
  printf 'prune: removed %d dead drone(s): %s\n' "${#dead[@]}" "${dead[*]}"
  [ -n "$arch" ] && echo "prune: archive $arch"
}

cmd_rename() {  # rename <old> <new>
  local old="${1:?usage: hive rename <old> <new>}"; local new="${2:?missing new name}"
  [[ "$new" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "name '$new' rejected: herdr requires [a-z][a-z0-9_-]{0,31}"
  local ws pane; ws=$(meta_get "$old" workspace_id) || die "unknown drone: $old"
  pane=$(pane_of "$old")
  herdr workspace rename "$ws" "$new" >/dev/null 2>&1
  herdr agent rename "$pane" "$new" >/dev/null 2>&1
  mv "$(drone_dir "$old")" "$(drone_dir "$new")"
  python3 -c "
import json
p='$(drone_dir "$new")/meta.json'
d=json.load(open(p)); d['name']='$new'; json.dump(d,open(p,'w'),indent=1)"
  echo "rename: $old -> $new"
}

cmd_unblock() {  # unblock <name> — answers the dialog a drone is stuck on
  local name="${1:?usage: hive unblock <name>}"
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  local dlg; dlg=$(pane_dialog "$pane" 2>/dev/null) || dlg=""
  case "$dlg" in
    resume)
      # The recommended option ("Resume from summary") is the preselected one, so Enter takes it.
      # Replaying the full session instead would burn a large share of the usage limit for a drone
      # that already lost the thread — the summary is what the swarm wants here.
      herdr agent send-keys "$name" enter >/dev/null 2>&1 \
        || die "unblock: could not send the key to $name" ;;
    trust)
      # Default button is "No, exit" (quits Claude Code) — arrow down to "Yes, I trust this
      # folder" before confirming, or unblock would kill the drone it means to rescue.
      herdr agent send-keys "$name" down >/dev/null 2>&1 \
        || die "unblock: could not send the key to $name"
      sleep 0.3
      herdr agent send-keys "$name" enter >/dev/null 2>&1 \
        || die "unblock: could not send the key to $name" ;;
    consent)
      # Option 2 = "Yes, I accept" — the same answer hive spawn gives at bootstrap.
      herdr pane send-text "$pane" 2 >/dev/null 2>&1
      sleep 1
      herdr agent send-keys "$name" enter >/dev/null 2>&1 \
        || die "unblock: could not send the key to $name" ;;
    permission)
      # A real decision, not a formality. Pressing Enter blind is exactly what the swarm's
      # safeguards exist to prevent.
      die "unblock: $name waits on a PERMISSION dialog — that is a decision, not a formality. Look first: hive peek $name" ;;
    *)
      echo "unblock: $name is not stuck on a dialog hive can answer (status: $(pane_status "$pane")) — nothing sent"
      return 1 ;;
  esac

  local i
  for i in $(seq 1 10); do
    sleep 1
    pane_dialog "$pane" >/dev/null 2>&1 \
      || { echo "unblock: $name answered ($dlg dialog cleared, status: $(pane_status "$pane"))"; return 0; }
  done
  echo "unblock: $name still shows a dialog after answering — look: hive peek $name" >&2
  return 1
}

cmd_adopt() {  # adopt <name> <pane_id> [--account NAME] — pulls a Claude Code started outside hive into the swarm
  local name="${1:?usage: hive adopt <name> <pane_id> [--account NAME]}"; local pane="${2:?missing pane_id}"
  shift 2
  # The account the agent runs on (e.g. one started with claude2) — 'revive' resumes it there.
  local account=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) account="${2?--account needs a name}"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  account_dir "$account" >/dev/null || exit 1
  [ "$account" = default ] && account=""
  [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "name '$name' rejected: herdr requires [a-z][a-z0-9_-]{0,31}"
  [ -f "$(drone_meta "$name")" ] && die "drone $name already exists — pick another name"
  local info; info=$(herdr pane get "$pane" 2>/dev/null) || die "no such pane: $pane"
  local agent; agent=$(jqp "print(r['pane'].get('agent') or '')" <<<"$info")
  [ "$agent" = claude ] || die "pane $pane does not host a claude agent (it hosts: ${agent:-nothing})"

  local ws cwd sid
  pane=$(jqp "print(r['pane']['pane_id'])" <<<"$info")
  ws=$(jqp "print(r['pane']['workspace_id'])" <<<"$info")
  # --resume looks the session up by the directory Claude Code runs in: the foreground cwd.
  cwd=$(jqp "p=r['pane']; print(p.get('foreground_cwd') or p.get('cwd') or '')" <<<"$info")
  # Reported by herdr's claude integration — without it 'revive' cannot restore the history.
  sid=$(jqp "
s=r['pane'].get('agent_session') or {}
print(s.get('value','') if s.get('kind')=='id' else '')" <<<"$info")

  # revive closes the drone's workspace — adopting the coordinator's own pane, or another drone's,
  # would hand that workspace to the wrong owner.
  [ "$pane" = "$(coord_pane)" ] && die "pane $pane is the coordinator's pane"
  local m
  for m in "$DRONES_DIR"/*/meta.json; do
    [ -f "$m" ] || continue
    [ "$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('pane_id',''))" "$m" 2>/dev/null)" = "$pane" ] \
      && die "pane $pane already belongs to drone $(basename "$(dirname "$m")")"
  done

  # The name is claimed in herdr first: agent names are unique among live agents, and a drone
  # registered under a name held by someone else would have its tasks delivered to that agent.
  herdr agent rename "$pane" "$name" >/dev/null 2>&1 \
    || die "herdr refused the name '$name' (taken by another live agent?) — nothing adopted"
  herdr workspace rename "$ws" "$name" >/dev/null 2>&1

  local dir; dir=$(drone_dir "$name"); mkdir -p "$dir"
  rm -f "$dir"/.sweep-* "$dir/.killed"   # leftovers of a ghost directory must not judge the new drone
  # 'adopted' marks a drone without the swarm env: until revive it has no HIVE_DRONE, so its
  # 'hive inbox' would read the COORDINATOR's mailbox — wake_recipient leaves it alone.
  python3 - "$dir" "$name" "$ws" "$pane" "$sid" "$cwd" "$account" <<'PY'
import json,sys
d,name,ws,pane,sid,cwd,account = sys.argv[1:8]
json.dump({"name":name,"workspace_id":ws,"pane_id":pane,"session_id":sid,"cwd":cwd,"account":account,
           "adopted":True},
          open(f"{d}/meta.json","w"), indent=1)
PY

  echo "adopt: $name  ws=$ws pane=$pane account=$(account_label "$account") cwd=$cwd"
  local missing=""
  [ -n "$sid" ] || missing="session_id"
  [ -n "$cwd" ] || missing="${missing:+$missing and }cwd"
  if [ -n "$missing" ]; then
    echo "warning: herdr reported no $missing — 'hive revive' would lose the history and refuses to run for $name" >&2
    return 0
  fi
  echo "sid=$sid"
  # revive closes the drone's whole workspace — an adopted agent may share it with other panes.
  local panes; panes=$(herdr workspace get "$ws" 2>/dev/null | jqp "print(r['workspace'].get('pane_count') or 0)")
  [ "${panes:-0}" -gt 1 ] 2>/dev/null \
    && echo "warning: workspace $ws holds $panes panes — 'hive revive' closes the whole workspace, not just this pane" >&2
  cat <<EOF
note: an adopted agent has no swarm hooks (it will not report in), no swarm env and no mail protocol.
Full integration: hive revive $name   (restart with --resume; the conversation history survives)
EOF
}

cmd_revive() {  # revive <name> [--account NAME] — resurrects a drone with its conversation history intact
  local name="${1:?usage: hive revive <name> [--account NAME]}"; shift
  local cwd; cwd=$(meta_get "$name" cwd) || die "unknown drone: $name"
  # A drone comes back on the account it ran on. --account moves it; without it the drone moves
  # only when its account has no room left (over its threshold, full, unusable, disabled) — then to
  # the account 'hive accounts' selects. With HIVE_ACCOUNT pinned or no accounts.conf it never moves.
  local account account_given=0; account=$(meta_get "$name" account)
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) account="${2?--account needs a name}"; account_given=1; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  # Checked before the workspace is closed: without both, spawn would start a fresh session (or
  # none at all) after the old one is already gone — the history would be lost, not revived.
  local sid; sid=$(meta_get "$name" session_id)
  [ -n "$sid" ] && [ -n "$cwd" ] || die "revive: $name has no recorded session id or cwd — it cannot be resumed; nothing closed"
  if [ "$account_given" = 0 ] && auto_account; then
    # Only an account that sees the transcript qualifies, so a move can never lose the history.
    local picked was; was=$(account_label "$account")
    picked=$(account_pick "$sid" "$was") \
      || die "revive: no account for $name — nothing closed. To bring it back where it ran: hive revive $name --account $was"
    account="${picked%%$'\t'*}"
    if [ "$account" = "$was" ]; then echo "revive: $name stays on $account — ${picked#*$'\t'}"
    else echo "revive: $name moves $was -> $account — ${picked#*$'\t'}"; fi
  fi
  local acc_dir; acc_dir=$(account_dir "$account") || exit 1
  # A move between accounts resumes only when the target account sees the transcript, i.e. both
  # share projects/ (the ~/.claude-<name>/projects symlink). Checked here, while the drone lives.
  if [ "$(account_label "$account")" != "$(account_label "$(meta_get "$name" account)")" ]; then
    compgen -G "${acc_dir:-$HOME/.claude}/projects/*/$sid.jsonl" >/dev/null \
      || die "revive: account '$(account_label "$account")' does not see session $sid (projects/ not shared with the drone's account?) — nothing closed"
  fi
  local ws; ws=$(meta_get "$name" workspace_id)
  herdr workspace close "$ws" >/dev/null 2>&1
  cmd_spawn "$name" --cwd "$cwd" --account "$account" --resume
}

# --- reconciliation sweep -------------------------------------------------
# Mail delivery is event-driven, and every event can be lost: an expired or unarmed
# coordinator watcher, a dead drone pane, Esc on a queued drone prompt, a failed ssh forward,
# a hook that never fired because the drone crashed mid-turn. The sweep is the level-triggered
# floor under all of it — run periodically (systemd user timer, installed by install.sh), it
# pings the human about coord mail nobody watches, retries lost drone wake-ups, reminds the
# human about overdue mail, and surfaces drones that went silent with a task in flight.
# Every alert is rate-limited: a sweep that nags every five minutes trains everyone
# to ignore it, and then it protects nothing.

sweep_alert() {  # sweep_alert <drone> <state> <subject> <body> — letter to coord, rate-limited
  local name="$1" state="$2" subject="$3" body="$4"
  local mark="$DRONES_DIR/$name/.sweep-$state" age
  if [ -f "$mark" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$mark" 2>/dev/null || echo 0) ))
    [ "$age" -lt "${HIVE_SWEEP_RENOTIFY:-1800}" ] && return 0
  fi
  : > "$mark"
  HIVE_DRONE=sweep KIND=sweep "$SKILL_DIR/hive" send coord "$subject" --body "$body" >/dev/null 2>&1
  echo "sweep: $subject"
}

cmd_sweep() {  # sweep — one reconciliation pass; safe to run any time, quiet when all is well
  # Without a reachable herdr server nothing can be woken or notified — a swarm without herdr
  # is not asleep, it is off. Stay silent instead of mailing "drone is dead" about every drone.
  herdr_reachable || return 0

  local now; now=$(date +%s)
  local remote; remote=$(coord_remote)

  # 1. Coordinator mail: with no live watcher, ping the human (rate-limited) — or, for a remote
  #    coordinator, retry the ssh forward that failed at send time.
  local -a letters=()
  local f
  while IFS= read -r f; do letters+=("$f"); done \
    < <(find "$MAIL_DIR/coord" -maxdepth 1 -name '*.json' 2>/dev/null | sort)
  if [ ${#letters[@]} -gt 0 ]; then
    if [ -n "$remote" ]; then
      local lfrom lkind lsubj lhost; lhost=$(hostname -s)
      for f in "${letters[@]}"; do
        lfrom=$(jqf "$f" from | head -1); lkind=$(jqf "$f" kind | head -1)
        lsubj=$(jqf "$f" subject | head -1)
        if python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('body') or '', end='')" "$f" \
           | ssh -o BatchMode=yes -o ConnectTimeout=5 "$remote" \
               "HIVE_DRONE=$(printf '%q' "$lfrom@$lhost") KIND=$(printf '%q' "${lkind:-msg}") \
                \"\$HOME/.claude/skills/hivemind/hive\" send coord $(printf '%q' "$lsubj")" \
               >/dev/null 2>&1
        then
          mkdir -p "$MAIL_DIR/.archive"; mv "$f" "$MAIL_DIR/.archive/"
          echo "sweep: forwarded stranded letter to coord@$remote ($lsubj)"
        fi
      done
      letters=()
      while IFS= read -r f; do letters+=("$f"); done \
        < <(find "$MAIL_DIR/coord" -maxdepth 1 -name '*.json' 2>/dev/null | sort)
    else
      wake_recipient coord
    fi
  fi
  # Overdue reminder: mail nobody read for HIVE_MAIL_OVERDUE means the coordinator is not
  # hearing it — tell the human on the desktop, re-nag at most every HIVE_SWEEP_RENOTIFY.
  if [ ${#letters[@]} -gt 0 ]; then
    local oldest age mark="$HIVE_DIR/.overdue-notice" skip=0 mage
    oldest=$(stat -c %Y "${letters[0]}" 2>/dev/null || echo "$now")
    age=$(( now - oldest ))
    if [ "$age" -ge "${HIVE_MAIL_OVERDUE:-1800}" ]; then
      if [ -f "$mark" ]; then
        mage=$(( now - $(stat -c %Y "$mark" 2>/dev/null || echo 0) ))
        [ "$mage" -lt "${HIVE_SWEEP_RENOTIFY:-1800}" ] && skip=1
      fi
      if [ "$skip" = 0 ]; then
        : > "$mark"
        herdr notification show \
          "Swarm mail unread for $((age/60)) min (${#letters[@]} letter(s) for coord) — run hive inbox in the coordinator pane" \
          --sound request >/dev/null 2>&1
        echo "sweep: overdue mail reminder (${#letters[@]} letters, $((age/60)) min old)"
      fi
    fi
  fi

  # 2. Drone mailboxes: retry lost drone wake-ups (wake_recipient's safeguards — drones only,
  #    the coordinator has its watcher).
  local box name
  for box in "$MAIL_DIR"/*/; do
    [ -d "$box" ] || continue
    name=$(basename "$box")
    case "$name" in coord|.archive) continue ;; esac
    ls "$box"/*.json >/dev/null 2>&1 || continue
    [ -f "$(drone_meta "$name")" ] || continue
    wake_recipient "$name"
  done

  # 3. Drones silent with a task in flight. The Stop/Notification hooks should have
  #    mailed coord; when they did not (hook failure, crash, a dialog nobody saw),
  #    the coordinator learns it HERE instead of from the user asking why everything
  #    stands still.
  local d st brief_age
  for d in "$DRONES_DIR"/*/; do
    [ -f "$d/meta.json" ] || continue
    name=$(basename "$d")
    [ -f "$d/.mute" ]   && continue     # conversational drone — the human drives it
    [ -f "$d/.killed" ] && continue     # deliberately concluded, corpse kept for its report
    [ -f "$d/brief.md" ]  || continue   # no task assigned yet
    [ -f "$d/report.md" ] && continue   # task concluded
    st=$(pane_status "$(pane_of "$name")")
    # A drone whose context ran out waits on the resume dialog. herdr may report that as
    # blocked or merely idle, so the dialog itself decides — and the alert names the cure
    # instead of leaving the coordinator to rediscover it every time.
    local dlg=""
    case "$st" in blocked|idle|done|unknown) dlg=$(pane_dialog "$(pane_of "$name")" 2>/dev/null) || dlg="" ;; esac
    if [ "$dlg" = resume ]; then
      if [ "${HIVE_SWEEP_AUTOUNBLOCK:-0}" = 1 ]; then
        cmd_unblock "$name" >/dev/null 2>&1 \
          && { echo "sweep: answered the resume dialog for $name"; continue; }
      fi
      sweep_alert "$name" resume "SWEEP: drone $name waits on the resume dialog" \
        "Its context ran out and the session asks how to resume. Answer it: hive unblock $name"
      continue
    fi
    case "$st" in
      dead)
        sweep_alert "$name" dead "SWEEP: drone $name is dead, task unfinished" \
          "No report and its pane is gone. Revive with history: hive revive $name — or conclude it: hive kill $name" ;;
      blocked)
        sweep_alert "$name" blocked "SWEEP: drone $name is blocked on a dialog" \
          "Look with hive peek $name; usually answered by: herdr agent send-keys $name enter" ;;
      idle|done)
        sweep_alert "$name" idle "SWEEP: drone $name sits $st without a report" \
          "Its turn ended but report.md never appeared (report skipped or hook mail lost). Check hive peek $name or: hive say $name 'write the report per the brief'" ;;
      working)
        brief_age=$(( now - $(stat -c %Y "$d/brief.md" 2>/dev/null || echo "$now") ))
        if [ "$brief_age" -ge "${HIVE_WORKING_WARN:-3600}" ]; then
          sweep_alert "$name" working "SWEEP: drone $name working $((brief_age/60)) min, no report yet" \
            "Long tasks happen; if this one should not be one, check hive peek $name"
        fi ;;
    esac
  done
  return 0
}

# AN ACT, NOT A DESCRIPTION. Reason (ffprobegate, 2026-07-28): every LETTER about the gate contains
# gate words — that is a property of correspondence, not a flaw of the pattern; the more precisely the
# swarm describes the gate, the more phantoms a content filter sees. Filtering by subject text is
# undecidable BY PRINCIPLE. So entering and releasing are a SEPARATE COMMAND with nothing in common
# with sending mail: the act stops being a description and becomes an invocation.
# Position 1 used to mean TWO things at once: "the one INSIDE" and "the one who is NEXT". Both looked
# identical (a bare number) and telling them apart required combining two sources instead of one read.
gate_queue_print() {
  local qf="$1" in_window i=0
  # The "already had a window" marker must refer to THIS round of the queue, not all history: the first
  # version marked everyone whose LAST event was a RELEASE — including three hours ago on another task.
  # An overbroad claim, same family as "at all" / "7/7". Only releases AFTER the queue was set count
  # (queue file mtime).
  local after_window qset
  qset=$(date -d "@$(stat -c %Y "$qf" 2>/dev/null || echo 0)" -Is 2>/dev/null || echo 0)
  after_window=$(awk -v since="$qset" '$3=="RELEASE" && $1 > since {seen[$2]=1} END{for (w in seen) print w}' \
             "$HIVE_DIR/gate.log" 2>/dev/null)
  in_window=$(awk '{last[$2]=$3} END{for (w in last) if (last[w]=="ENTER") print w}' \
            "$HIVE_DIR/gate.log" 2>/dev/null)
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    i=$((i+1))
    if printf '%s\n' "$in_window" | grep -qx -- "$n"; then
      printf '%2d. %s  <- IN THE WINDOW NOW (not waiting)\n' "$i" "$n"
    elif printf '%s\n' "$after_window" | grep -qx -- "$n"; then
      # The queue and gate.log used to say TWO DIFFERENT things about one person — released at 12:33,
      # still listed as "waiting" five minutes later, because `pop` is done by a HUMAN. An entry whose
      # owner already has a RELEASE in the log is marked — the coordinator still decides the pop, but
      # nobody has to guess it by eye.
      printf '%2d. %s  (ALREADY HAD A WINDOW — pop it: hive gate queue pop)\n' "$i" "$n"
    else
      printf '%2d. %s  (waiting)\n' "$i" "$n"
    fi
  done < "$qf"
}

cmd_usage() {  # usage [--cwd DIR] [--timeout SEC] — measures the account limits with a throwaway Claude session (/usage)
  # The coordinator cannot see the usage counter from inside its own session, and a fleet of drones burns
  # the weekly limit in hours. This starts a fresh `claude` in a tmux session (in a TRUSTED directory —
  # the trust dialog is not answered on purpose), types /usage, captures the panel and kills the session.
  local cwd="$PWD" timeout=45 account="${HIVE_ACCOUNT:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="${2:?--cwd needs a path}"; shift 2 ;;
      --timeout) timeout="${2:?--timeout needs seconds}"; shift 2 ;;
      --account) account="${2?--account needs a name}"; shift 2 ;;
      *) echo "hive: usage: unknown argument $1" >&2; return 2 ;;
    esac
  done
  usage_precheck "$account" "$cwd" || return 1
  echo "account: $(account_label "$account")"
  local out; out=$(usage_capture "$account" "$cwd" "$timeout") || return 1
  # Print the panel compactly: the section label, its percentage and its reset time; strip the bars.
  printf '%s\n' "$out" | sed 's/[█▌▏▎▍▋▊▉ ]\{3,\}/ /g' | grep -E 'Current session|Current week|% used|Resets|promo' \
    | sed 's/^ *//' | uniq
}

cmd_accounts() {  # accounts [--refresh] [--pick] — the accounts, their limits, and the one a spawn would take
  local refresh=0 pick=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --refresh) refresh=1; shift ;;
      --pick) pick=1; shift ;;
      *) echo "hive: accounts: unknown argument $1" >&2; return 2 ;;
    esac
  done
  accounts_py check || return 1
  if [ "$refresh" = 1 ]; then accounts_refresh all || return 1; fi
  if [ "$pick" = 1 ]; then
    # The spawn's own answer, measurement included — not the table's reading of an old cache.
    if [ -n "${HIVE_ACCOUNT:-}" ]; then
      printf '%s — HIVE_ACCOUNT pins it; the automatic selection is off\n' "$(account_label "$HIVE_ACCOUNT")"
      return 0
    fi
    local picked; picked=$(account_pick) || return 1
    printf '%s — %s\n' "${picked%%$'\t'*}" "${picked#*$'\t'}"
    return 0
  fi
  accounts_py table
}

# The machine gate: one exclusive window for anything that eats the whole machine (full test gates,
# browser proofs). History that shaped it, condensed: three drones entered within four minutes when
# `enter` did not check the log; check-then-append without a lock left a race window; entries without
# a description turned out to be backticks in echo messages, never intentional.
cmd_gate() {  # gate enter|release|status|queue|force-release [description]
  local sub="${1:?usage: hive gate enter|release|status|queue|force-release [description]}"; shift || true
  local who="${HIVE_DRONE:-coord}" desc="${*:-}"
  case "$sub" in
    # `status` answers "is someone INSIDE"; the queue answers "who is PROMISED next". The queue must
    # live WHERE PEOPLE LOOK — not in someone else's mailbox (two collisions in one day taught this).
    queue)
      local qf="$HIVE_DIR/gate.queue" sub2="${1:-list}"; shift || true
      case "$sub2" in
        set)   printf '%s\n' "$@" | tr ' ' '\n' | grep -v '^$' > "$qf"; echo "queue set:"; gate_queue_print "$qf" ;;
        pop)   if [ -s "$qf" ]; then h=$(head -1 "$qf"); tail -n +2 "$qf" > "$qf.tmp" && mv "$qf.tmp" "$qf"; echo "popped: $h"; else echo "queue empty"; fi ;;
        clear) : > "$qf"; echo "queue cleared" ;;
        *)     if [ -s "$qf" ]; then gate_queue_print "$qf"; else echo "queue empty"; fi ;;
      esac
      return 0 ;;
    enter|release)
      local kind=ENTER; [ "$sub" = release ] && kind=RELEASE
      # An entry without a description is never intentional: whoever enters deliberately says what for
      # and roughly how long. Refusing closes the whole class of accidental entries (backticks in echo
      # once RAN `hive gate enter` with an empty description — zero human decisions involved).
      if [ "$kind" = ENTER ] && [ -z "${desc//[[:space:]]/}" ]; then
        echo "gate: ENTER WITHOUT A DESCRIPTION — not recording." >&2
        echo "      Whoever enters deliberately says WHAT FOR and HOW LONG: hive gate enter '<desc, ~N min>'" >&2
        echo "      If you did not invoke this on purpose: check for BACKTICKS in echo messages." >&2
        return 2
      fi
      # `enter` used to append a line and nothing more — the gate admitted everyone who typed the
      # command; three concurrent windows in four minutes were measured from gate.log. Discipline that
      # depends on a drone reading `status` output IS NOT a gate. And check-then-append is not atomic
      # without a lock: two `enter`s in the same instant would both see a free gate. flock closes it.
      exec 8>"$HIVE_DIR/.gate-lock"
      flock -w 10 8 || { echo "gate: cannot take the gate lock (10 s) — try again." >&2; return 5; }
      if [ "$kind" = ENTER ]; then
        # Default capacity 2: two windows may run side by side; the third is refused. Tune with
        # HIVE_GATE_CAPACITY to what the machine can carry. Browser-proof-bearing runs SAY SO in the
        # description and avoid pairing with another proof-bearing run; any flake under a pair ->
        # A-B-A, then solo.
        local open n_open cap="${HIVE_GATE_CAPACITY:-2}"
        open=$(awk '{last[$2]=$3; line[$2]=$0} END{for (w in last) if (last[w]=="ENTER") print line[w]}' \
                 "$HIVE_DIR/gate.log" 2>/dev/null | sort)
        n_open=0; [ -n "$open" ] && n_open=$(printf '%s\n' "$open" | wc -l)
        if [ "$n_open" -ge "$cap" ]; then
          echo "gate: REFUSED — $n_open open window(s) at capacity $cap:" >&2
          printf '%s\n' "$open" | sed 's/^/  /' >&2
          echo "      You do not enter. Wait for a NAMED release or write to the coordinator." >&2
          echo "      If a window is DEAD (its drone is gone): hive gate force-release <drone> '<reason>'" >&2
          return 3
        fi
        if [ "$n_open" -ge 1 ]; then
          echo "gate: entering as window $((n_open+1)) of $cap — already open:"
          printf '%s\n' "$open" | sed 's/^/  /'
        fi
      fi
      printf '%s %s %s %s\n' "$(date -Is)" "$who" "$kind" "$desc" >> "$HIVE_DIR/gate.log"
      echo "gate: $who $kind $desc" ;;
    # The only emergency exit: a window left by a dead drone would block the gate FOREVER, because
    # `release` closes its OWN author's window. A reason is required — closing someone else's window
    # without one is indistinguishable from ignoring the gate.
    force-release)
      local victim="${1:?usage: hive gate force-release <drone> '<reason>'}"; shift || true
      local reason="${*:-}"
      if [ -z "${reason//[[:space:]]/}" ]; then
        echo "gate: force-release WITHOUT A REASON — not recording." >&2
        return 2
      fi
      printf '%s %s %s %s\n' "$(date -Is)" "$victim" RELEASE \
        "RELEASED BY $who: $reason" >> "$HIVE_DIR/gate.log"
      echo "gate: $who CLOSED the window of drone $victim — $reason" ;;
    status)
      # The log is append-only, so file order IS time order; we never compare timestamps (awk once read
      # "2026-07-28T..." as the number 2026 on both sides — "later than" was always false). For EVERY
      # person we take their LAST record, and we report ALL open windows, not just the latest: two
      # unreleased entries are a COLLISION, and showing only the last one sweeps it under the rug.
      if [ -s "$HIVE_DIR/gate.queue" ]; then
        echo "queue (coordinator's assignment, top first):"
        gate_queue_print "$HIVE_DIR/gate.queue" | sed 's/^/  /'
      else
        echo "queue: EMPTY — that does NOT mean \"free to enter\". Ask the coordinator."
      fi
      local open
      open=$(awk '{last[$2]=$3; line[$2]=$0} END{for (w in last) if (last[w]=="ENTER") print line[w]}' \
                "$HIVE_DIR/gate.log" 2>/dev/null | sort)
      if ! grep -q ' ENTER ' "$HIVE_DIR/gate.log" 2>/dev/null; then
        echo "gate: NO ENTRIES in the log — that does NOT mean free. Ask."; return 4
      fi
      if [ -z "$open" ]; then echo "gate: FREE (no window is open)"; return 0; fi
      local n; n=$(printf '%s\n' "$open" | wc -l)
      local cap="${HIVE_GATE_CAPACITY:-2}"
      if [ "$n" -gt "$cap" ]; then echo "gate: COLLISION — $n open windows over capacity $cap:";
      elif [ "$n" -ge "$cap" ]; then echo "gate: FULL ($n of $cap windows):";
      else echo "gate: BUSY ($n of $cap windows):"; fi
      printf '%s\n' "$open" | sed 's/^/  /'
      return 3 ;;
    *) echo "usage: hive gate enter|release|status|queue|force-release [description]"; return 2 ;;
  esac
}

case "${1:-}" in
  spawn)  shift; cmd_spawn  "$@" ;;
  task)   shift; cmd_task   "$@" ;;
  say)    shift; cmd_say    "$@" ;;
  clear)  shift; cmd_clear  "$@" ;;
  send)   shift; cmd_send   "$@" ;;
  inbox)  shift; cmd_inbox  "$@" ;;
  watch)  shift; cmd_watch  "$@" ;;
  coord)  shift
          # Either branch is a coordinator handover: it clears a wake-up marker left by
          # pre-watcher versions, and the new coordinator learns about backlog immediately —
          # letters stranded by a dead predecessor surface here, not at the next send.
          if [ "${1:-}" = --remote ]; then
            [ -n "${2:-}" ] || die "usage: hive coord --remote <ssh-host>"
            printf '%s\n' "$2" > "$HIVE_DIR/coord.remote"
            rm -f "$HIVE_DIR/coord.pane" "$HIVE_DIR/.wake-coord" "$HIVE_DIR/.stranded-notice"
            echo "coord: remote at $2 — coord mail is forwarded over ssh"
          else
            rm -f "$HIVE_DIR/coord.remote" "$HIVE_DIR/.wake-coord" "$HIVE_DIR/.stranded-notice"
            herdr pane current --current 2>/dev/null | jqp "print(r['pane']['pane_id'])" > "$HIVE_DIR/coord.pane"
            echo "coord: $(coord_pane)"
            # Always, even with a fresh heartbeat: that proves some watcher lives, not that this
            # session has one — and re-arming is harmless, the last armed watcher wins.
            echo "coord: arm the mail watcher — $WATCH_ARM; re-arm it every time it expires"
          fi
          backlog=$(find "$MAIL_DIR/coord" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l)
          if [ "$backlog" -gt 0 ]; then
            echo "coord: $backlog unread letter(s) waiting — run: hive inbox"
          fi ;;
  _pending) shift; prompt_pending "${1:?missing pane}" ;;   # internal, for drone-ping.sh
  _watched) coord_watched ;;                                   # internal, for coord-creed-inject.sh
  status) shift; cmd_status "$@" ;;
  wait)   shift; cmd_wait   "$@" ;;
  report) shift; cmd_report "$@" ;;
  mute)   shift; cmd_mute   "$@" ;;
  peek)   shift; cmd_peek   "$@" ;;
  kill)   shift; cmd_kill   "$@" ;;
  prune)  shift; cmd_prune  "$@" ;;
  rename) shift; cmd_rename "$@" ;;
  revive) shift; cmd_revive "$@" ;;
  adopt)  shift; cmd_adopt  "$@" ;;
  unblock) shift; cmd_unblock "$@" ;;
  sweep)  shift; cmd_sweep  "$@" ;;
  gate)   shift; cmd_gate   "$@" ;;
  usage)  shift; cmd_usage  "$@" ;;
  accounts) shift; cmd_accounts "$@" ;;
  _usage-parse) shift; accounts_py parse "${1:?missing panel file}" ${2:+"$2"} ;;   # internal, for tests/accounts
  *) cat <<'EOF'
hive — command a swarm of Claude Code agents in herdr

  hive spawn  <name> [--cwd PATH] [--account NAME]  new drone (opus, skip-permissions, own workspace)
  hive task   <name> <file|->        send a brief (file or stdin) + report protocol
  hive say    <name> <text>          ad-hoc message to a drone
  hive clear  <name>                 clear the drone's input field (when foreign text hangs there)
  hive send   <to> <subject> [--body T] swarm mail (to: coord | drone | all) + drone wake-up / watcher notice (coord)
  hive inbox  [who] [--keep]         read and consume a mailbox (own by default)
  hive watch                         coordinator's mail watcher — arm it as a Monitor (one line per new letter)
  hive coord                         register the current pane as the coordinator pane
  hive coord --remote <ssh-host>     coordinator lives on another machine — forward coord mail over ssh
  hive status [name]                 swarm state table (never blocks)
  hive wait   [names] [--timeout S]  wait for reports, hard limit (default 300s)
  hive report <name>                 show a drone's report
  hive mute   <name> [--off]         silence automatic wake-ups (conversational drone)
  hive usage  [--cwd DIR] [--account NAME]  measure the account limits (/usage in a throwaway session)
  hive accounts [--refresh] [--pick] accounts table: limits, resets, status, and the one a spawn takes
                                     (--refresh measures every enabled account; --pick prints the pick and why)
  hive peek   <name> [lines]         view of the drone's terminal
  hive kill   <name> [--purge]       kill a drone (a dead one is archived and removed)
  hive prune  [--purge] [--dry-run] [names]  clear out dead drones (archived unless --purge)
  hive rename <old> <new>            rename a drone and its workspace
  hive revive <name> [--account NAME]  resurrect a drone with its history (--resume); --account moves it
  hive adopt  <name> <pane_id> [--account NAME]  pull a Claude Code started outside hive into the swarm
  hive unblock <name>                answer the dialog a drone is stuck on (resume/trust/consent)
  hive sweep                         reconciliation pass: retry lost wake-ups, surface silent drones
                                     (a systemd user timer runs it every 5 min — install.sh sets it up)
  hive gate   <enter|release|status|queue> [desc]  one exclusive machine window for full gates (flock-backed)

Model: $HIVE_MODEL (default opus).  Data: ~/.herdr-hive/drones/<name>/
Accounts: --account NAME runs on CLAUDE_CONFIG_DIR=~/.claude-NAME (logged in, onboarded);
          HIVE_ACCOUNT sets the default for spawn and usage; none/"default" = ~/.claude.
          With ~/.herdr-hive/accounts.conf, spawn and revive without --account/HIVE_ACCOUNT take the
          account 'hive accounts' marks SELECTED: lowest prio under its threshold, measured by /usage.
EOF
  ;;
esac
