# ~/.herdr-hive/clickup/config — turns ClickUp task tracking on (see "Task tracking in ClickUp" in
# SKILL.md). Without this file hive makes no ClickUp call and a brief needs no task.
# Format: key = value, one a line; lines starting with # are comments. Lists are separated by '|'.

# Where the swarm's tasks live: the workspace (team) id, the space and the list new tasks go to.
workspace = 1234567
space = 7654321
list = 9012345678

# The API token: a command printing it on stdout (preferred — a password manager or a secret store),
# or a file holding it (mode 0600). hive reads it once per command into a private directory; it never
# reaches argv, a log or a letter.
token_cmd = pass show clickup/api-token
# token_file = ~/.config/clickup/token

# Statuses, as the list names them (case does not matter).
# early: a drone starting on such a task moves it to status_start.
status_early = backlog | to do | ready
# active: a task in one of these collides on its modules.
status_active = ready | in progress | in review
# info: a task in one of these (its code merged, e.g. testing) is listed by the gate and 'hive ct check'
# but needs no 'Collision checked' line; a living drone on it still collides, as every drone at work does.
status_info = testing
# closed: the sync never reopens one.
status_closed = done | cancelled
# start: where 'hive task' moves an early task.
status_start = in progress
# done: what a drone's 'done' or 'complete' means.
status_done = done
# With status_unverified set, status_done needs a '## Prod' section in the report (what was checked
# in production); without one the task lands here instead and the coordinator gets a letter.
status_unverified = testing
# A tag whose tasks may reach status_done without '## Prod' (e.g. an analysis, done once delivered).
verify_exempt = type-analysis

# 'hive ct decision': the list of the decisions the coordinators wait on from the owner, next to the
# tasks' list. Its first open status means waiting, its first closed one answered. Without it the
# decision commands are off.
# decision_list = 9012345679

# 'hive ct todo': the checklist a small step goes to when no --checklist is named.
# checklist = Small steps

# 'hive ct stale' (run by hand, never on a timer): tasks left lying, only those of the caller's front
# (HIVE_FRONT). A task moved when it was updated, commented on, or reported on by a drone whose
# meta.json or brief names it. An empty list or target turns its rule off. Rule 1: a task in
# stale_testing not moved for stale_testing_days goes to stale_testing_to (defaults:
# status_unverified, 7, status_done).
# stale_testing = testing
# stale_testing_days = 7
# stale_testing_to = done
# Rule 2: a task in stale_hold not moved for stale_hold_days (default 14), and named by no brief of a
# drone alive or changed within those days, goes to stale_hold_to. Off unless both are set.
# stale_hold = on hold | backlog
# stale_hold_days = 14
# stale_hold_to = cancelled
# A person's task under rule 2 is only listed, to be checked by hand: one assigned to anybody, or with
# one of these tags. So is a task the swarm never worked on: no drone's directory names it and none of
# its latest 25 comments has a line of its own hive-start:<drone>:<time> or hive-report:<drone>:<mtime>.
# stale_human_tags = human

# Boundary blocks that make a brief read-only (an analysis, a review): a brief whose 'Rules:' lines
# name one of them, whatever other blocks they name, skips the collision check and its
# 'Collision checked:' lines are ignored, so it comments on no other task. The rest of the gate stays.
# Empty or absent: every brief is checked for collisions.
# read_only_rules = analysis | review

# Tag prefixes: on the command line and in a brief a module, an area, a type or a front may be named
# without its prefix ('Modules: api' for the tag mod-api). The front tag is <prefix_front><front name>.
prefix_front = front-
prefix_module = mod-
prefix_area = area-
prefix_type = type-

# Extra names for the brief's lines, e.g. in your own language: 'Modules:', 'Impact:', 'none' and
# 'Collision checked:' always work.
# alias_modules = Modul
# alias_impact = Wirkung
# alias_none = keine
# alias_collision = Kollision geprueft
